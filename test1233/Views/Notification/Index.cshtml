@model test1233.Models.PagedListViewModel<test1233.Models.AppNotification>

@{
    ViewData["Title"] = "Notifications";
    var currentSearch = ViewData["CurrentSearch"] as string ?? string.Empty;
    var currentSort = ViewData["CurrentSort"] as string ?? string.Empty;
    var notificationSort = ViewData["NotificationSort"] as string ?? "notification_asc";
    var userSort = ViewData["UserSort"] as string ?? "user_asc";
}

<style>
    .sort-header-link {
        display: inline;
        padding: 0;
        border-radius: 0;
        color: #817d7d !important;
        font-weight: 600;
        line-height: inherit;
        vertical-align: baseline;
    }

    .sort-header-link:hover,
    .sort-header-link:focus {
        color: #0c062b !important;
    }
</style>

<div class="container py-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h1 class="h3 mb-1">Notifications Management</h1>
            <p class="text-muted mb-0">Manage notifications and link each one to a user.</p>
        </div>
        <a asp-action="Create" class="btn search-action-button">Add Notifications</a>
    </div>

    <form method="get" class="row g-2 align-items-end mb-4">
        <div class="col-sm-8 col-md-6 col-lg-4">
            <label for="searchString" class="form-label">Search notifications</label>
            <input id="searchString" name="searchString" value="@currentSearch" class="form-control" placeholder="Search by Username" />  
        </div>
        <div class="col-auto">
            <button asp-action="Index" type="submit" class="btn search-action-button">Search</button>
        </div>
        <input type="hidden" name="sortOrder" value="@currentSort" />
        <div class="col-auto">
            <a asp-action="Index" class="btn btn-outline-secondary clear-action-button">Clear</a>
        </div>
    </form>

    <div class="card shadow-sm border-0">
        <div class="card-body">
            @if (Model.Items.Count == 0)
            {
                <div class="text-muted">
                    No notifications found@(string.IsNullOrWhiteSpace(currentSearch) ? "." : $" for \"{currentSearch}\".").
                </div>
            }
            else
            {
                <div class="table-responsive">
                    <table class="table table-striped align-middle mb-0">
                        <thead>
                            <tr>
                                <th>
                                    <a class="sort-header-link text-decoration-none"
                                       asp-action="Index"
                                       asp-route-searchString="@currentSearch"
                                       asp-route-sortOrder="@notificationSort">Notification</a>
                                </th>
                                <th>
                                    <a class="sort-header-link text-decoration-none"
                                       asp-action="Index"
                                       asp-route-searchString="@currentSearch"
                                       asp-route-sortOrder="@userSort">User</a>
                                </th>
                                <th class="text-end">Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                        @foreach (var notification in Model.Items)
                        {
                            <tr>
                                <td>@notification.Notification</td>
                                <td>@notification.UserName</td>
                                <td class="text-end">
                                    <a asp-action="Edit" asp-route-id="@notification.NotificationId" class="btn btn-sm btn-outline-secondary grid-action-button">Edit</a>
                                    <a asp-action="Delete" asp-route-id="@notification.NotificationId" class="btn btn-sm btn-outline-danger grid-action-button">Delete</a>
                                </td>
                            </tr>
                        }
                        </tbody>
                    </table>
                </div>

                <div class="d-flex justify-content-between align-items-center mt-4">
                    <span class="text-muted small">Page @Model.PageNumber of @Model.TotalPages</span>
                    <nav aria-label="Notification pagination">
                        <ul class="pagination mb-0">
                            <li class="page-item @(Model.HasPreviousPage ? string.Empty : "disabled")">
                                <a class="page-link"
                                   asp-action="Index"
                                   asp-route-page="@(Model.PageNumber - 1)"
                                   asp-route-sortOrder="@currentSort"
                                   asp-route-searchString="@currentSearch">Previous</a>
                            </li>
                            @for (var pageNumber = 1; pageNumber <= Model.TotalPages; pageNumber++)
                            {
                                <li class="page-item @(pageNumber == Model.PageNumber ? "active" : string.Empty)">
                                    <a class="page-link"
                                       asp-action="Index"
                                       asp-route-page="@pageNumber"
                                       asp-route-sortOrder="@currentSort"
                                       asp-route-searchString="@currentSearch">@pageNumber</a>
                                </li>
                            }
                            <li class="page-item @(Model.HasNextPage ? string.Empty : "disabled")">
                                <a class="page-link"
                                   asp-action="Index"
                                   asp-route-page="@(Model.PageNumber + 1)"
                                   asp-route-sortOrder="@currentSort"
                                   asp-route-searchString="@currentSearch">Next</a>
                            </li>
                        </ul>
                    </nav>
                </div>
            }
        </div>
    </div>
</div>
