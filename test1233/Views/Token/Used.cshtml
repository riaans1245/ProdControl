@model IReadOnlyCollection<test1233.Models.AppUsedToken>

@{
    ViewData["Title"] = "Used Tokens";
}

<div class="container py-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h1 class="h3 mb-1">Used Tokens</h1>
            <p class="text-muted mb-0">Tokens sent to the administrator from the user API.</p>
        </div>
        <a asp-action="Index" class="btn btn-outline-secondary">Back to Tokens</a>
    </div>

    <div class="card shadow-sm border-0">
        <div class="card-body">
            @if (Model.Count == 0)
            {
                <div class="text-muted">No used tokens have been sent yet.</div>
            }
            else
            {
                <div class="table-responsive">
                    <table class="table table-striped align-middle mb-0">
                        <thead>
                            <tr>
                                <th>Username</th>
                                <th>User ID</th>
                                <th>Token</th>
                                <th>Sent</th>
                            </tr>
                        </thead>
                        <tbody>
                        @foreach (var token in Model)
                        {
                            <tr>
                                <td>@token.Username</td>
                                <td>@token.UserId</td>
                                <td>@token.Token</td>
                                <td>@token.SentAtUtc.ToLocalTime().ToString("yyyy-MM-dd HH:mm:ss")</td>
                            </tr>
                        }
                        </tbody>
                    </table>
                </div>
            }
        </div>
    </div>
</div>
