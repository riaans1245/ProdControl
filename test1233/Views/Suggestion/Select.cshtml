@model test1233.Models.SuggestionFormViewModel

@{
    ViewData["Title"] = "Edit Suggestion";
}

<div class="container py-4" style="max-width: 620px;">
    <div class="card shadow-sm border-0">
        <div class="card-body p-4">
            <h1 class="h3 mb-1">Suggestion</h1>
            
                <div class="card shadow-sm border-0">
                    <div class="card-body">
                        
                            <form method="post">
                                @Html.AntiForgeryToken()
                                <input asp-for="SuggestId" type="hidden" />
                                <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

                                <dl class="row mb-4">
                                    <dt class="col-sm-3">User name</dt>
                                    <dd class="col-sm-9">@Model.MyName</dd>

                                    <dt class="col-sm-3">Suggestion</dt>
                                    <dd class="col-sm-9" rows="5">@Model.Suggestion</dd>
                                </dl>

                                <div class="d-flex gap-2">
                                    <button asp-action="Delete" type="submit" class="btn btn-outline-danger" onclick="return confirm('Are you sure you want to delete this item?');">Delete</button>
                                    <a asp-action="Index" class="btn btn-outline-secondary clear-action-button">Cancel</a>
                                </div>
                            </form>
                        
                    </div>
                </div>
        
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
