@model test1233.Models.PagedListViewModel<test1233.Models.AppTokens>

@{
    ViewData["Title"] = "Tokens";
    var currentSearch = ViewData["CurrentSearch"] as string ?? string.Empty;
}

<div class="container py-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h1 class="h3 mb-1">Token Management</h1>
            <p class="text-muted mb-0">Manage tokens and link each one to a user.</p>
        </div>
        <div class="d-flex gap-2">
            @* <a asp-action="Used" class="btn btn-outline-secondary">View Used Tokens</a> *@
            <a asp-action="Create" class="btn text-white" style="background-color: #080808; color: #123246;">Add Token</a>
        </div>
    </div>

    <form asp-action="Index" method="get" class="row g-2 align-items-end mb-4">
        <div class="col-sm-8 col-md-6 col-lg-4">
            <label for="searchString" class="form-label">Search tokens</label>
            <input id="searchString"
                   name="searchString"
                   value="@currentSearch"
                   class="form-control"
                   placeholder="Search by token, username, or user ID" />
        </div>
        <div class="col-auto">
            <button type="submit" class="btn btn-dark">Search</button>
        </div>
        <div class="col-auto">
            <a asp-action="Index" class="btn btn-outline-secondary">Clear</a>
        </div>
    </form>

    <div class="card shadow-sm border-0">
        <div class="card-body">
            @if (Model.Items.Count == 0)
            {
                <div class="text-muted">
                    No tokens found@(string.IsNullOrWhiteSpace(currentSearch) ? "." : $" for \"{currentSearch}\".").
                </div>
            }
            else
            {
                <div class="table-responsive">
                    <table class="table table-striped align-middle mb-0">
                        <thead>
                            <tr>
                                <th>Token</th>
                                <th>User</th>
                                <th class="text-end">Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                        @foreach (var tokens in Model.Items)
                        {
                            <tr>
                                <td>@tokens.Token</td>
                                <td>@tokens.Username</td>
                                <td class="text-end">
                                    <a asp-action="Edit" asp-route-id="@tokens.TokenId" class="btn btn-sm btn-outline-secondary">Edit</a>
                                    <a asp-action="Delete" asp-route-id="@tokens.TokenId" class="btn btn-sm btn-outline-danger">Delete</a>
                                </td>
                            </tr>
                        }
                        </tbody>
                    </table>
                </div>

                <div class="d-flex justify-content-between align-items-center mt-4">
                    <span class="text-muted small">Page @Model.PageNumber of @Model.TotalPages</span>
                    <nav aria-label="Token pagination">
                        <ul class="pagination mb-0">
                            <li class="page-item @(Model.HasPreviousPage ? string.Empty : "disabled")">
                                <a class="page-link"
                                   asp-action="Index"
                                   asp-route-page="@(Model.PageNumber - 1)"
                                   asp-route-searchString="@currentSearch">Previous</a>
                            </li>
                            @for (var pageNumber = 1; pageNumber <= Model.TotalPages; pageNumber++)
                            {
                                <li class="page-item @(pageNumber == Model.PageNumber ? "active" : string.Empty)">
                                    <a class="page-link"
                                       asp-action="Index"
                                       asp-route-page="@pageNumber"
                                       asp-route-searchString="@currentSearch">@pageNumber</a>
                                </li>
                            }
                            <li class="page-item @(Model.HasNextPage ? string.Empty : "disabled")">
                                <a class="page-link"
                                   asp-action="Index"
                                   asp-route-page="@(Model.PageNumber + 1)"
                                   asp-route-searchString="@currentSearch">Next</a>
                            </li>
                        </ul>
                    </nav>
                </div>
            }
        </div>
    </div>
</div>
