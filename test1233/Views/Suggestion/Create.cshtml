@model test1233.Models.SuggestionFormViewModel

@{
    ViewData["Title"] = "Suggestions";
}

<div class="container py-4" style="max-width: 980px;">
    <div class="row g-4">
        <div class="col-lg-5">
            <div class="card shadow-sm border-0 h-100 public-contact-card">
                <div class="card-body p-4">
                    <p class="text-uppercase small fw-semibold mb-2 public-section-kicker">Suggestions for Easy Eats</p>
                    <h1 class="h3 mb-3">We are happy to help.</h1>
                    <p class="text-muted">Reach out if you have suggestions about food, service, the website, menu access, tokens, or your customer profile.</p>

                    <div class="mt-4 d-grid gap-3">
                        <div>
                            <div class="fw-semibold">Phone</div>
                            <div class="text-muted">123456</div>
                        </div>
                        <div>
                            <div class="fw-semibold">Email</div>
                            <div class="text-muted">wwwww@ddd.co.nz</div>
                        </div>
                        <div>
                            <div class="fw-semibold">Best use</div>
                            <div class="text-muted">Share ideas to improve food, service, website access, tokens, or your profile experience.</div>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-lg-7">
            <div class="card shadow-sm border-0">
                <div class="card-body p-4">
                    <h2 class="h4 mb-3">Send us your suggestion</h2>
                    <p class="text-muted">We read through all suggestions and use them to improve the experience.</p>

                    <form method="post">
                        @Html.AntiForgeryToken()
                        <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

                        <div class="row g-3">
                            <div class="col-md-6">
                                <label asp-for="MyName" class="form-label"></label>
                                <input asp-for="MyName" class="form-control" />
                                <span asp-validation-for="MyName" class="text-danger"></span>
                            </div>

                            <div class="col-md-6">
                                <label asp-for="Suggestion" class="form-label"></label>
                                <textarea name="Suggestion" rows="4" class="form-control" placeholder="Enter your text here..."></textarea>
                                <span asp-validation-for="Suggestion" class="text-danger"></span>
                            </div>
                        </div>

                        <button asp-action="Create" type="submit" class="btn search-action-button w-100 mt-4">Submit</button>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
