@model test1233.Models.LoyaltyAdminViewModel

@{
    ViewData["Title"] = "Loyalty Points";
}

<div class="container py-4">
    <div class="d-flex justify-content-between align-items-end mb-4">
        <div>
            <h1 class="h3 mb-1">Loyalty Points</h1>
            <p class="text-muted mb-0">Customer points, issued $20 vouchers, and voucher delivery details.</p>
        </div>
    </div>

    <div class="row g-3 mb-4">
        <div class="col-md-6"><div class="card border-0 shadow-sm"><div class="card-body"><div class="small text-muted">Total points received</div><div class="h3 mb-0">@Model.TotalPointsReceived</div></div></div></div>
        <div class="col-md-6"><div class="card border-0 shadow-sm"><div class="card-body"><div class="small text-muted">$20 vouchers issued</div><div class="h3 mb-0">@Model.TotalVouchersIssued</div></div></div></div>
    </div> 

    <div class="card shadow-sm border-0">
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-striped align-middle mb-0">
                    <thead>
                        <tr>
                            <th>Customer</th>
                            <th>Email vouchers are sent to</th>
                            <th class="text-end">Total points received</th>
                            <th class="text-end">Vouchers received</th>
                            <th class="text-end">Points left</th>
                        </tr>
                    </thead>
                    <tbody>
                    @foreach (var user in Model.Users)
                    {
                        <tr>
                            <td><div class="fw-semibold">@user.Username</div><div class="small text-muted">User #@user.UserId</div></td>
                            <td>@user.EmailAddress</td>
                            <td class="text-end">@user.TotalPointsReceived</td>
                            <td class="text-end">@user.VouchersReceived</td>
                            <td class="text-end text-success fw-semibold">@user.PointsLeft</td>
                        </tr>
                    }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>
