@model test1233.Models.ContactUs
@{
    ViewData["Title"] = "Contact Us";
}

<div class="container py-4" style="max-width: 980px;">
    <div class="row g-4">
        <div class="col-lg-5">
            <div class="card shadow-sm border-0 h-100 public-contact-card">
                <div class="card-body p-4">
                    <p class="text-uppercase small fw-semibold mb-2 public-section-kicker">Contact Easy Eats</p>
                    <h1 class="h3 mb-3">We are happy to help.</h1>
                    <p class="text-muted">Reach out if you have questions about accounts, menu access, tokens, or your customer profile.</p>

                    <div class="mt-4 d-grid gap-3">
                        <div>
                            <div class="fw-semibold">Phone</div>
                            <div class="text-muted">123456</div>
                        </div>
                        <div>
                            <div class="fw-semibold">Email</div>
                            <div class="text-muted">wwwww@ddd.co.nz</div>
                        </div>
                        <div>
                            <div class="fw-semibold">Best use</div>
                            <div class="text-muted">General questions, account support, and service follow-up.</div>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-lg-7">
            <div class="card shadow-sm border-0">
                <div class="card-body p-4">
                    <h2 class="h4 mb-3">Send us your details</h2>
                    <p class="text-muted">Leave your contact information below and the team can get back to you.</p>

                    @if (TempData["ContactSuccess"] is string contactSuccess)
                    {
                        <div class="alert alert-success" role="alert">
                            @contactSuccess
                        </div>
                    }

                    <form asp-action="ContactUs" method="post">
                        @Html.AntiForgeryToken()
                        <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

                        <div class="row g-3">
                            <div class="col-md-6">
                                <label asp-for="Name" class="form-label"></label>
                                <input asp-for="Name" class="form-control" />
                                <span asp-validation-for="Name" class="text-danger"></span>
                            </div>

                            <div class="col-md-6">
                                <label asp-for="Surname" class="form-label"></label>
                                <input asp-for="Surname" class="form-control" />
                                <span asp-validation-for="Surname" class="text-danger"></span>
                            </div>

                            <div class="col-md-6">
                                <label asp-for="CellNo" class="form-label"></label>
                                <input asp-for="CellNo" class="form-control" />
                                <span asp-validation-for="CellNo" class="text-danger"></span>
                            </div>

                            <div class="col-md-6">
                                <label asp-for="EmailAddress" class="form-label"></label>
                                <input asp-for="EmailAddress" class="form-control" />
                                <span asp-validation-for="EmailAddress" class="text-danger"></span>
                            </div>
                        </div>

                        <button type="submit" class="btn btn-dark w-100 mt-4">Submit</button>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
