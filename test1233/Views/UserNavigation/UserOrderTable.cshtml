@model IReadOnlyCollection<test1233.Models.AppTables>

@{
    ViewData["Title"] = "Table Booking";
    string FormatBookingDate(DateTime? value) =>
        value.HasValue ? value.Value.ToString("dd MMM yyyy HH:mm") : "Not booked";
}

<div class="container py-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h1 class="h3 mb-1">Table Booking</h1>
            <p class="text-muted mb-0">Browse available tables and choose one for an order.</p>
        </div>
    </div>

    <div class="card shadow-sm border-0">
        <div class="card-body">
            @if (Model.Count == 0)
            {
                <div class="alert alert-light border mb-0">No tables are available yet.</div>
            }
            else
            {
                <div class="table-responsive">
                    <table class="table table-striped align-middle mb-0">
                        <thead>
                            <tr>
                                <th>Table Name</th>
                                <th>Table Number</th>
                                <th>User</th>
                                <th>Booked For</th>
                                <th class="text-end">Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var table in Model)
                            {
                                <tr>
                                    <td>@table.TableName</td>
                                    <td>@table.TableNumber</td>
                                    <td>@table.Username</td>
                                    <td>@FormatBookingDate(table.BookedForUtc)</td>
                                    <td class="text-end">
                                        <a asp-controller="UserNavigation" asp-action="UserBookMe" asp-route-TableId="@table.TableId" class="btn btn-sm btn-outline-secondary">Book Me</a>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        </div>
    </div>
</div>
