@model test1233.Models.AppTables

@{
    ViewData["Title"] = "Delete Tables";
}

<div class="container py-4" style="max-width: 620px;">
    <div class="card shadow-sm border-0">
        <div class="card-body p-4">
            <h1 class="h3 mb-3">Delete Tables</h1>
            <p class="text-muted">Are you sure you want to delete this Table?</p>
            
            <dl class="row mb-4">
                <dt class="col-sm-3">Table Name</dt>
                <dd class="col-sm-9">@Model.TableName</dd>

                <dt class="col-sm-3">Table Number</dt>
                <dd class="col-sm-9">@Model.TableNumber</dd>
            </dl>
            
            <form method="post">
                @Html.AntiForgeryToken()
                <input asp-for="TableId" type="hidden" />
                <div class="d-flex gap-2">
                    <button asp-asp-controller="Table" asp-action="Delete" type="submit" class="btn btn-outline-danger" onclick="return confirm('Are you sure you want to delete this item?');">Delete</button>
                    <a asp-action="Index" class="btn btn-outline-secondary clear-action-button">Cancel</a>
                </div>
            </form>
        </div>
    </div>
</div>
