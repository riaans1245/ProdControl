
@model test1233.Models.PagedListViewModel<test1233.Models.AppTables>

@{
    ViewData["Title"] = "Table Booking";
}

<div class="container py-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h1 class="h3 mb-1">Table Management</h1>
            <p class="text-muted mb-0">Manage table bookings and link each one to a user.</p>
        </div>
        <a asp-action="Create" class="btn text-white" style="background-color: #080808; color: #123246;">Add Tables</a>
    </div>

    <div class="card shadow-sm border-0">
        <div class="card-body">
            @if (Model.Items.Count == 0)
            {
                <div class="alert alert-light border mb-0">No tables are available yet.</div>
            }
            else
            {
                <div class="table-responsive">
                    <table class="table table-striped align-middle mb-0">
                        <thead>
                            <tr>
                                <th>Table Name</th>
                                <th>Table Number</th>
                                <th>User</th>
                                 <th class="text-end">Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var table in Model.Items)
                            {
                                <tr>
                                    <td>@table.TableName</td>
                                    <td>@table.TableNumber</td>
                                    <td>@table.Username</td>
                                     <td class="text-end">
                                    <a asp-controller="Table" asp-action="BookMe" asp-route-TableId="@table.TableId" class="btn btn-sm btn-outline-secondary">Book</a>
                                    <a asp-controller="Table" asp-action="Edit" asp-route-TableId="@table.TableId" class="btn btn-sm btn-outline-secondary">Edit</a>
                                    <a asp-action="Delete" asp-route-id="@table.TableId" class="btn btn-sm btn-outline-danger">Delete</a>
                                </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        </div>
    </div>
</div>
