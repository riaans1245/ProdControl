@model IReadOnlyCollection<test1233.Models.ProductIngredientListItemViewModel>

@{
    ViewData["Title"] = "Product ingredients";
    var currentSearch = ViewData["CurrentSearch"] as string ?? string.Empty;
    var currentSort = ViewData["CurrentSort"] as string ?? string.Empty;
    var productSort = ViewData["ProductSort"] as string ?? "product_asc";
    var ingredientsSort = ViewData["IngredientsSort"] as string ?? "ingredients_asc";
    var pageNumber = ViewData["PageNumber"] as int? ?? 1;
    var totalPages = ViewData["TotalPages"] as int? ?? 1;
    var hasPreviousPage = pageNumber > 1;
    var hasNextPage = pageNumber < totalPages;
}

<style>
    .sort-header-link {
        display: inline;
        padding: 0;
        border-radius: 0;
        color: #817d7d !important;
        font-weight: 600;
        line-height: inherit;
        vertical-align: baseline;
    }

    .sort-header-link:hover,
    .sort-header-link:focus {
        color: #0c062b !important;
    }
</style>

<div class="container py-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h1 class="h3 mb-1">Product Ingredients</h1>
            <p class="text-muted mb-0">Manage product ingredient details across the menu.</p>
        </div>
        <a asp-action="Create" class="btn search-action-button">Add Ingredience</a>
    </div>

    <form asp-action="Index" method="get" class="row g-2 align-items-end mb-4">
        <div class="col-sm-8 col-md-6 col-lg-4">
            <label for="searchString" class="form-label">Search product ingredients</label>
            <input id="searchString" name="searchString" value="@currentSearch" class="form-control" placeholder="Search by product or ingredient" />
        </div>
        <div class="col-auto">
            <button asp-action="Index" type="submit" class="btn search-action-button">Search</button>
        </div>
        <input type="hidden" name="sortOrder" value="@currentSort" />
        <div class="col-auto">
            <a asp-action="Index" class="btn btn-outline-secondary clear-action-button">Clear</a>
        </div>
    </form>

    <div class="card shadow-sm border-0">
        <div class="card-body">
            @if (Model.Count == 0)
            {
                <div class="text-muted">
                    No product ingredients found@(string.IsNullOrWhiteSpace(currentSearch) ? "." : $" for \"{currentSearch}\".").
                </div>
            }
            else
            {
                <div class="table-responsive">
                    <table class="table table-striped align-middle mb-0">
                        <thead>
                            <tr>
                                <th>
                                    <a class="sort-header-link text-decoration-none"
                                       asp-action="Index"
                                       asp-route-searchString="@currentSearch"
                                       asp-route-sortOrder="@productSort">Product</a>
                                </th>
                                <th>
                                    <a class="sort-header-link text-decoration-none"
                                       asp-action="Index"
                                       asp-route-searchString="@currentSearch"
                                       asp-route-sortOrder="@ingredientsSort">Ingredients</a>
                                </th>
                                <th class="text-end">Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                        @foreach (var productIng in Model)
                        {
                            <tr>
                                <td>@productIng.Name</td>
                                <td>@productIng.ProdIngredienceName</td>
                                <td class="text-end">
                                    <a asp-controller="ProductIngredients" asp-action="Edit" asp-route-id="@productIng.Id" class="btn btn-sm btn-outline-secondary grid-action-button">Edit</a>
                                    <a asp-action="Delete" asp-route-id="@productIng.Id" class="btn btn-sm btn-outline-danger grid-action-button">Delete</a>
                                </td>
                            </tr>
                        }
                        </tbody>
                    </table>
                </div>
            }
            <div class="d-flex justify-content-between align-items-center mt-4">
                <span class="text-muted small">Page @pageNumber of @totalPages</span>
                <nav aria-label="Product ingredients pagination">
                    <ul class="pagination mb-0">
                        <li class="page-item @(hasPreviousPage ? string.Empty : "disabled")">
                            <a class="page-link"
                               asp-action="Index"
                               asp-route-searchString="@currentSearch"
                               asp-route-sortOrder="@currentSort"
                               asp-route-page="@(pageNumber - 1)">Previous</a>
                        </li>
                        @for (var currentPage = 1; currentPage <= totalPages; currentPage++)
                        {
                            <li class="page-item @(currentPage == pageNumber ? "active" : string.Empty)">
                                <a class="page-link"
                                   asp-action="Index"
                                   asp-route-searchString="@currentSearch"
                                   asp-route-sortOrder="@currentSort"
                                   asp-route-page="@currentPage">@currentPage</a>
                            </li>
                        }
                        <li class="page-item @(hasNextPage ? string.Empty : "disabled")">
                            <a class="page-link"
                               asp-action="Index"
                               asp-route-searchString="@currentSearch"
                               asp-route-sortOrder="@currentSort"
                               asp-route-page="@(pageNumber + 1)">Next</a>
                        </li>
                    </ul>
                </nav>
            </div>
        </div>
    </div>
</div>
