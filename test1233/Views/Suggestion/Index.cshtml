@model test1233.Models.PagedListViewModel<test1233.Models.AppSuggestion>
@inject test1233.Services.IUserStore UserStore

@{
    var isUser = User.IsInRole("Users");
    var isAdmin = User.IsInRole("Admin");
    var currentSearch = ViewData["CurrentSearch"] as string ?? string.Empty;
    ViewData["Title"] = "Suggestion";
}

<div class="container py-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h1 class="h3 mb-1">All Suggestions</h1>
            <p class="text-muted mb-0">Read all the suggestions.</p>
        </div>
    @if (isUser)
        {
            <a asp-action="Create" class="btn text-white" style="background-color: #080808; color: #123246;">Add Suggestion</a>
        }
    </div>

    <form method="get" class="row g-2 align-items-end mb-4">
        <div class="col-sm-8 col-md-6 col-lg-4">
            <label for="searchString" class="form-label">Search suggestions</label>
            <input id="searchString" name="searchString" value="@currentSearch" class="form-control" placeholder="Search by Name, Suggestion." />    
        </div>
        <div class="col-auto">
            <button asp-action="Index" type="submit" class="btn btn-dark">Search</button>
        </div>
        <div class="col-auto">
            <a asp-action="Index" class="btn btn-outline-secondary">Clear</a>
        </div>
    </form>

    <div class="card shadow-sm border-0">
        <div class="card-body">
            @if (Model.Items.Count == 0)
            {
                <div class="text-muted">
                    No suggestions found@(string.IsNullOrWhiteSpace(currentSearch) ? "." : $" for \"{currentSearch}\".").
                </div>
            }
            else
            {
                <div class="table-responsive">
                    @if (User.Identity?.Name == null || isUser)
                    {
                        <table class="table table-striped align-middle mb-0">
                            <thead>
                                <tr>
                                    <th>Suggestion From</th>
                                    <th>Suggestion</th>
                                </tr>
                            </thead>
                            <tbody>
                            @foreach (var suggestion in Model.Items)
                            {
                                <tr>
                                    <td>@suggestion.MyName</td>
                                    <td>@suggestion.Suggestion</td>
                                </tr>
                            }
                            </tbody>
                        </table>
                    }
                    else
                    {
                        <table class="table table-striped align-middle mb-0">
                            <thead>
                                <tr>
                                    <th>Suggestion From</th>
                                    <th>Suggestion</th>
                                    <th class="text-end">Actions</th>
                                </tr>
                            </thead>
                            <tbody>
                            @foreach (var suggestion in Model.Items)
                            {
                                <tr>
                                    <td>@suggestion.MyName</td>
                                    <td>
                                        @(suggestion.Suggestion?.Length > 40
                                            ? suggestion.Suggestion.Substring(0, 40) + "..."
                                            : suggestion.Suggestion)
                                    </td>
                                    <td class="text-end">
                                        <a asp-action="Select" asp-route-id="@suggestion.SuggestId" class="btn btn-sm btn-outline-secondary">Select</a>
                                    </td>
                                </tr>
                            }
                            </tbody>
                        </table>
                    }
                </div>

                <div class="d-flex justify-content-between align-items-center mt-4">
                    <span class="text-muted small">Page @Model.PageNumber of @Model.TotalPages</span>
                    <nav aria-label="Suggestion pagination">
                        <ul class="pagination mb-0">
                            <li class="page-item @(Model.HasPreviousPage ? string.Empty : "disabled")">
                                <a class="page-link"
                                   asp-action="Index"
                                   asp-route-page="@(Model.PageNumber - 1)"
                                   asp-route-searchString="@currentSearch">Previous</a>
                            </li>
                            @for (var pageNumber = 1; pageNumber <= Model.TotalPages; pageNumber++)
                            {
                                <li class="page-item @(pageNumber == Model.PageNumber ? "active" : string.Empty)">
                                    <a class="page-link"
                                       asp-action="Index"
                                       asp-route-page="@pageNumber"
                                       asp-route-searchString="@currentSearch">@pageNumber</a>
                                </li>
                            }
                            <li class="page-item @(Model.HasNextPage ? string.Empty : "disabled")">
                                <a class="page-link"
                                   asp-action="Index"
                                   asp-route-page="@(Model.PageNumber + 1)"
                                   asp-route-searchString="@currentSearch">Next</a>
                            </li>
                        </ul>
                    </nav>
                </div>
            }
        </div>
    </div>
</div>
