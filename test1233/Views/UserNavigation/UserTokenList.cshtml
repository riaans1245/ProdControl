@model IReadOnlyCollection<test1233.Models.AppTokens>

@{
    ViewData["Title"] = "My Tokens";
}

<div class="container py-4">
    @if (TempData["TokenApiMessage"] is string tokenApiMessage && !string.IsNullOrWhiteSpace(tokenApiMessage))
    {
        <div class="alert alert-info alert-dismissible fade show" role="alert">
            @tokenApiMessage
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h1 class="h3 mb-1">My Tokens</h1>
            <p class="text-muted mb-0">View all tokens assigned to your account.</p>
        </div>
    </div>

    <div class="card shadow-sm border-0">
        <div class="card-body">
            @if (Model.Count == 0)
            {
                <div class="text-muted">No tokens are currently assigned to your account.</div>
            }
            else
            {
                <div class="table-responsive">
                    <table class="table table-striped align-middle mb-0">
                        <thead>
                            <tr>
                                <th>Token</th>
                                <th>User</th>
                                <th class="text-end">Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                        @foreach (var tokens in Model)
                        {
                            <tr>
                                <td>@tokens.Token</td>
                                <td>@tokens.Username</td>
                                <td class="text-end">
                                <a asp-action="Use" asp-route-id="@tokens.TokenId" class="btn btn-sm btn-outline-danger">Use Token</a>
                            </td>
                            </tr>
                        }
                        </tbody>
                    </table>
                </div>
            }
        </div>
    </div>
</div>
