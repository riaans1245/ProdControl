@model test1233.Models.UserOrderPlaceViewModel

@{
    ViewData["Title"] = "Place Order";
}

<div class="container py-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h1 class="h3 mb-1">Place Order</h1>
            <p class="text-muted mb-0">Confirm payment to generate your receipt and clear the order items from the grid.</p>
        </div>
    </div>

    @if (TempData["OrderPlaceMessage"] is string orderPlaceMessage && !string.IsNullOrWhiteSpace(orderPlaceMessage))
    {
        <div class="alert alert-info shadow-sm" role="alert">
            @orderPlaceMessage
        </div>
    }

    <div class="row g-4">
        <div class="col-xl-5">
            <div class="card shadow-sm border-0">
                <div class="card-body">
                    <p class="text-uppercase small fw-semibold mb-2 public-section-kicker">Payment Summary</p>
                    <h2 class="h4 mb-3">Ready to pay</h2>

                    @if (Model.PendingOrders.Count == 0)
                    {
                        <div class="text-muted">There are no order items ready for payment.</div>
                    }
                    else
                    {
                        <div class="border rounded-4 p-3 mb-3 bg-light">
                            <div class="d-flex justify-content-between mb-2">
                                <span>Total items</span>
                                <strong>@Model.TotalItems</strong>
                            </div>
                            <div class="d-flex justify-content-between">
                                <span>Total due</span>
                                <strong>@Model.TotalValue.ToString("C")</strong>
                            </div>
                        </div>

                        <form method="post" class="d-grid gap-2">
                            @Html.AntiForgeryToken()
                            <button asp-action="ConfirmPayment" type="submit" class="btn btn-success">Confirm Payment</button>
                            <a asp-action="UserOrderList" class="btn btn-outline-secondary">Back to Orders</a>
                        </form>
                    }
                </div>
            </div>
        </div>

        <div class="col-xl-7">
            <div class="card shadow-sm border-0" id="receipt-card">
                <div class="card-body">
                    <div class="d-flex justify-content-between align-items-start mb-3">
                        <div>
                            <p class="text-uppercase small fw-semibold mb-2 public-section-kicker">Receipt</p>
                            <h2 class="h4 mb-1">Easy Eats Payment Slip</h2>
                            <p class="text-muted mb-0">Your latest server-generated receipt appears here after payment is confirmed.</p>
                        </div>
                    </div>

                    @if (Model.LatestReceipt is null || Model.LatestReceipt.Items.Count == 0)
                    {
                        <div class="text-muted">No receipt has been generated yet.</div>
                    }
                    else
                    {
                        <div class="border rounded-4 p-3 mb-3 bg-light">
                            <div class="d-flex justify-content-between small mb-2">
                                <span class="text-muted">Receipt #</span>
                                <strong>@Model.LatestReceipt.ReceiptNumber</strong>
                            </div>
                            <div class="d-flex justify-content-between small mb-2">
                                <span class="text-muted">Paid</span>
                                <strong>@Model.LatestReceipt.PaidAtUtc.ToLocalTime().ToString("dd MMM yyyy h:mm tt")</strong>
                            </div>
                            <div class="d-flex justify-content-between small">
                                <span class="text-muted">Orders Included</span>
                                <strong>@string.Join(", ", Model.LatestReceipt.OrderIds)</strong>
                            </div>
                        </div>

                        <div class="table-responsive">
                            <table class="table table-sm align-middle mb-3">
                                <thead>
                                    <tr>
                                        <th>Item</th>
                                        <th class="text-end">Qty</th>
                                        <th class="text-end">Total</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var item in Model.LatestReceipt.Items)
                                    {
                                        <tr>
                                            <td>
                                                <div class="fw-semibold">@item.Name</div>
                                                <div class="small text-muted">@item.CategoryName</div>
                                            </td>
                                            <td class="text-end">@item.Quantity</td>
                                            <td class="text-end">@((item.Quantity * item.Price).ToString("C"))</td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>

                        <div class="border-top pt-3">
                            <div class="d-flex justify-content-between mb-2">
                                <span>Total items</span>
                                <strong>@Model.LatestReceipt.Items.Sum(item => item.Quantity)</strong>
                            </div>
                            <div class="d-flex justify-content-between">
                                <span>Total paid</span>
                                <strong>@Model.LatestReceipt.Items.Sum(item => item.Quantity * item.Price).ToString("C")</strong>
                            </div>
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>
</div>
