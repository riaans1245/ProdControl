@model test1233.Models.OrderingViewModel

@{
    ViewData["Title"] = "Ordering";
}

<style>
    .ordering-turquoise-text {
        color: #1f8a93 !important;
    }

    .ordering-turquoise-button {
        background-color: #0f5d63;
        border-color: #0f5d63;
        color: #f4ffff;
    }

    .ordering-turquoise-button:hover,
    .ordering-turquoise-button:focus {
        background-color: #0a4549;
        border-color: #0a4549;
        color: #ffffff;
        box-shadow: none;
    }

    .ordering-turquoise-button:disabled {
        background-color: #0f5d63;
        border-color: #0f5d63;
        color: rgba(244, 255, 255, 0.72);
        opacity: 0.75;
    }
</style>

<div class="container py-4">
    <div class="d-flex flex-column flex-lg-row justify-content-between align-items-lg-end gap-3 mb-4">
        <div>
            <h1 class="h3 mb-1">Ordering</h1>
            <p class="text-muted mb-0">Choose products, set quantities, and build your cart by clicking on the 'Add to Cart' button.</p>
            <p class="text-muted mb-0">Click on the 'Check Ingredients' to check the product.</p>
        </div>
        <div class="text-muted small">Signed in as <strong>@User.Identity?.Name</strong></div>
    </div>

    @if (TempData["OrderingMessage"] is string orderingMessage && !string.IsNullOrWhiteSpace(orderingMessage))
    {
        <div class="alert alert-info shadow-sm" role="alert">
            @orderingMessage
        </div>
    }

    <div class="row g-4">
        <div class="col-lg-8">
            <div class="row g-3">
                @foreach (var product in Model.Products)
                {
                    <div class="col-md-6">
                        <div class="card h-100 shadow-sm border-0">
                            <div class="card-body d-flex flex-column">
                                <div class="d-flex justify-content-between align-items-start gap-3 mb-2">
                                <form method="post">
                                    @Html.AntiForgeryToken()
                                    <input type="hidden" name="productId" value="@product.Id" />
                                    <div>
                                        <div class="text-muted small text-uppercase">@product.CategoryName</div>
                                        <hr />
                                            <h2 class="h5 mb-1">@product.Name</h2> 
                                        <hr />  
                                        <a class="left-nav-gallery-card left-nav-gallery-card-notifications" asp-route-id="@product.Id" asp-controller="ProductIngredients" asp-action="Index">
                                                <span class="left-nav-gallery-label">Check Ingredients - </span>
                                        </a> 
                                    </div>
                                </form>
                                    <div class="fw-bold ordering-turquoise-text">@product.Price.ToString("C")</div>
                                </div>

                                <form asp-action="AddToCart" method="post" class="mt-auto d-flex flex-wrap align-items-end gap-2">
                                    @Html.AntiForgeryToken()
                                    <input type="hidden" name="productId" value="@product.Id" />
                                    <div class="flex-grow-1">
                                        <label class="form-label small mb-1" for="qty-@product.Id">Quantity</label>
                                        <input id="qty-@product.Id"
                                               class="form-control"
                                               type="number"
                                               name="quantity"
                                               min="1"
                                               value="1" />
                                    </div>
                                    <button type="submit" class="btn ordering-turquoise-button">Add to cart</button>
                                </form>
                            </div>
                        </div>
                    </div>
                }
            </div>
        </div>

        <div class="col-lg-4">
            <div class="card shadow-sm border-0 sticky-top" style="top: 1.5rem;">
                <div class="card-body">
                    <div class="d-flex justify-content-between align-items-center mb-3">
                        <h2 class="h5 mb-0">Cart</h2>
                        <form asp-action="ClearCart" method="post" class="m-0">
                            @Html.AntiForgeryToken()
                            <button type="submit" class="btn btn-sm btn-outline-secondary clear-action-button" @(Model.CartItems.Count == 0 ? "disabled" : null)>Clear</button>
                        </form>
                    </div>

                    @if (Model.CartItems.Count == 0)
                    {
                        <div class="text-muted">Your cart is empty. Add products to begin an order.</div>
                    }
                    else
                    {
                        <div class="d-grid gap-3">
                            @foreach (var item in Model.CartItems)
                            {
                                <div class="border rounded-3 p-3 bg-light">
                                    <div class="d-flex justify-content-between gap-3">
                                        <div>
                                            <div class="fw-semibold">@item.Name</div>
                                            <div class="small text-muted">@item.CategoryName</div>
                                            <div class="small text-muted">@item.Quantity x @item.Price.ToString("C")</div>
                                        </div>
                                        <div class="text-end">
                                            <div class="fw-semibold">@((item.Quantity * item.Price).ToString("C"))</div>
                                            <form asp-action="RemoveFromCart" method="post" class="mt-2">
                                                @Html.AntiForgeryToken()
                                                <input type="hidden" name="productId" value="@item.ProductId" />
                                                <button type="submit" class="btn btn-sm btn-link text-danger p-0">Remove</button>
                                            </form>
                                        </div>
                                    </div>
                                </div>
                            }
                        </div>
                    }

                    <hr />

                    <div class="d-flex justify-content-between mb-2">
                        <span>Total items</span>
                        <strong>@Model.CartItemCount</strong>
                    </div>
                    <div class="d-flex justify-content-between">
                        <span>Total value</span>
                        <strong>@Model.CartTotalValue.ToString("C")</strong>
                    </div>

                    <form asp-action="CheckoutOrder" method="post" class="mt-4">
                        @Html.AntiForgeryToken()
                        <button type="submit" class="btn ordering-turquoise-button w-100" @(Model.CartItems.Count == 0 ? "disabled" : null)>Checkout Order</button>
                    </form>
                    <a asp-controller="UserNavigation" asp-action="UserOrderList" class="btn search-action-button w-100 mt-2">View order list</a>                
                </div>
            </div>
        </div>
    </div>
</div>
