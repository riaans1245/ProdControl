@model IReadOnlyCollection<test1233.Models.AppNotification>

@{
    ViewData["Title"] = "My Notifications";
}

<div class="container py-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h1 class="h3 mb-1">My Notifications</h1>
            <p class="text-muted mb-0">View notifications linked to your account.</p>
        </div>
    </div>

    <div class="card shadow-sm border-0">
        <div class="card-body">
            <div class="table-responsive">
                <table class="table table-striped align-middle mb-0">
                    <thead>
                        <tr>
                            <th>NotificationsId</th>
                            <th>Notification</th>
                            <th>User</th>
                        </tr>
                    </thead>
                    <tbody>
                    @foreach (var notifications in Model)
                    {
                        <tr>
                            <td>@notifications.NotificationId</td>
                            <td>@notifications.Notification</td>
                            <td>@notifications.UserName</td>
                        </tr>
                    }
                    </tbody>
                </table>
            </div>

        </div>
    </div>
</div>
