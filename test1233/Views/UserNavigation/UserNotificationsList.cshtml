@model test1233.Models.PagedListViewModel<test1233.Models.AppNotification>

@{
    ViewData["Title"] = "My Notifications";
    var currentSearch = ViewData["CurrentSearch"] as string ?? string.Empty;
}

<div class="container py-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h1 class="h3 mb-1">My Notifications</h1>
            <p class="text-muted mb-0">View notifications linked to your account.</p>
        </div>
    </div>

    <form class="row g-2 align-items-end mb-4">
        <div class="col-sm-8 col-md-6 col-lg-4">
            <label for="searchString" class="form-label">Search my notifications</label>
            <input id="searchString" name="searchString" value="@currentSearch" class="form-control" placeholder="Search by Notification" />  
        </div>
        <div class="col-auto">
            <button method="get" asp-action="UserNotificationsList" type="submit" class="btn search-action-button">Search</button>
        </div>
        <div class="col-auto">
            <a asp-action="UserNotificationsList" class="btn btn-outline-secondary clear-action-button">Clear</a>
        </div>
    </form>

    <div class="card shadow-sm border-0">
        <div class="card-body">
            @if (Model.Items.Count == 0)
            {
                <div class="text-muted">
                    No notifications found@(string.IsNullOrWhiteSpace(currentSearch) ? "." : $" for \"{currentSearch}\".").
                </div>
            }
            else
            {
                <div class="table-responsive">
                    <table class="table table-striped align-middle mb-0">
                        <thead>
                            <tr>
                                <th>Notification</th>
                                @* <th>User</th> *@
                            <th class="text-end">Actions</th>
                        </tr>
                        </thead>
                        <tbody>
                        @foreach (var notifications in Model.Items)
                        {
                            <tr>
                                <td>@notifications.Notification</td>
                                @* <td>@notifications.UserName</td> *@
                                <td class="text-end">
                                <a asp-action="UserNotificationDelete" asp-route-id="@notifications.NotificationId" class="btn btn-sm btn-outline-danger grid-action-button">Delete</a>
                            </td>
                            </tr>
                        }
                        </tbody>
                    </table>
                </div>

                <div class="d-flex justify-content-between align-items-center mt-4">
                    <span class="text-muted small">Page @Model.PageNumber of @Model.TotalPages</span>
                    <nav aria-label="My notification pagination">
                        <ul class="pagination mb-0">
                            <li class="page-item @(Model.HasPreviousPage ? string.Empty : "disabled")">
                                <a class="page-link"
                                   asp-action="UserNotificationsList"
                                   asp-route-page="@(Model.PageNumber - 1)"
                                   asp-route-searchString="@currentSearch">Previous</a>
                            </li>
                            @for (var pageNumber = 1; pageNumber <= Model.TotalPages; pageNumber++)
                            {
                                <li class="page-item @(pageNumber == Model.PageNumber ? "active" : string.Empty)">
                                    <a class="page-link"
                                       asp-action="UserNotificationsList"
                                       asp-route-page="@pageNumber"
                                       asp-route-searchString="@currentSearch">@pageNumber</a>
                                </li>
                            }
                            <li class="page-item @(Model.HasNextPage ? string.Empty : "disabled")">
                                <a class="page-link"
                                   asp-action="UserNotificationsList"
                                   asp-route-page="@(Model.PageNumber + 1)"
                                   asp-route-searchString="@currentSearch">Next</a>
                            </li>
                        </ul>
                    </nav>
                </div>
            }
        </div>
    </div>
</div>
