@model test1233.Models.AppSuggestion

@{
    ViewData["Title"] = "Suggestions";
}

<div class="container py-4" style="max-width: 980px;">
    <div class="row g-4">
        <div class="col-lg-5">
            <div class="card shadow-sm border-0 h-100 public-contact-card">
                <div class="card-body p-4">
                    <p class="text-uppercase small fw-semibold mb-2 public-section-kicker">Suggestions for Easy Eats</p>
                    <h1 class="h3 mb-3">We are happy to help.</h1>
                    <p class="text-muted">Reach out if you have any Suggestions about food, service, website, menu access, tokens, or your customer profile.</p>

                    <div class="mt-4 d-grid gap-3">
                        <div>
                            <div class="fw-semibold">Phone</div>
                            <div class="text-muted">123456</div>
                        </div>
                        <div>
                            <div class="fw-semibold">Email</div>
                            <div class="text-muted">wwwww@ddd.co.nz</div>
                        </div>
                        <div>
                            <div class="fw-semibold">Best use</div>
                            <div class="text-muted">Any Suggestions about food, service, website, menu access, tokens, or your customer profile.</div>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-lg-7">
            <div class="card shadow-sm border-0">
                <div class="card-body p-4">
                    <h2 class="h4 mb-3">Send us your Suggestion</h2>
                    <p class="text-muted">We read through all the Suggestions ans together we will make this experience great.</p>

                    @if (TempData["ContactSuccess"] is string contactSuccess)
                    {
                        <div class="alert alert-success" role="alert">
                            @contactSuccess
                        </div>
                    }

                    <form asp-action="Index" method="post">
                        @Html.AntiForgeryToken()
                        <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>
                        
                        <div class="row g-3">
                            <div class="col-md-6">
                                <label asp-for="MyName" class="form-label"></label>
                                <input asp-for="MyName" class="form-control" />
                                <span asp-validation-for="MyName" class="text-danger"></span>
                            </div>

                            <div class="col-md-6">
                                <label asp-for="Suggestion" class="form-label"></label>
                                <input asp-for="Suggestion" class="form-control" />
                                <span asp-validation-for="Suggestion" class="text-danger"></span>
                            </div>
                        </div>

                        <button type="submit" class="btn btn-dark w-100 mt-4">Submit</button>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}