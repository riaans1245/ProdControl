
@model test1233.Models.PagedListViewModel<test1233.Models.AppTables>

@{
    ViewData["Title"] = "Table Booking";
    var currentSort = ViewData["CurrentSort"] as string ?? string.Empty;
    var tableNameSort = ViewData["TableNameSort"] as string ?? "name_asc";
    var tableNumberSort = ViewData["TableNumberSort"] as string ?? "number_asc";
    var userSort = ViewData["UserSort"] as string ?? "user_asc";
    var bookedForSort = ViewData["BookedForSort"] as string ?? "bookedfor_asc";
    string FormatBookingDate(DateTime? value) =>
        value.HasValue ? value.Value.ToString("dd MMM yyyy HH:mm") : "Not booked";
}

<style>
    .sort-header-link {
        display: inline;
        padding: 0;
        border-radius: 0;
        color: #817d7d !important;
        font-weight: 600;
        line-height: inherit;
        vertical-align: baseline;
    }

    .sort-header-link:hover,
    .sort-header-link:focus {
        color: #0c062b !important;
    }
</style>

<div class="container py-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h1 class="h3 mb-1">Table Management</h1>
            <p class="text-muted mb-0">Manage table bookings and link each one to a user.</p>
        </div>
        <div class="d-flex gap-2 align-items-center">
           <a asp-controller="Table" asp-action="Index" class="btn btn-outline-secondary clear-action-button">Back</a>
        </div>
    </div>

    <div class="card shadow-sm border-0">
        <div class="card-body">
            @if (Model.Items.Count == 0)
            {
                <div class="alert alert-light border mb-0">No tables are available yet.</div>
            }
            else
            {
                <div class="table-responsive">
                    <table class="table table-striped align-middle mb-0">
                        <thead>
                            <tr>
                                <th>
                                    <a class="sort-header-link text-decoration-none" asp-action="Index" asp-route-sortOrder="@tableNameSort">Table Name</a>
                                </th>
                                <th>
                                    <a class="sort-header-link text-decoration-none" asp-action="Index" asp-route-sortOrder="@tableNumberSort">Table Number</a>
                                </th>
                                <th>
                                    <a class="sort-header-link text-decoration-none" asp-action="Index" asp-route-sortOrder="@userSort">User</a>
                                </th>
                                <th>
                                    <a class="sort-header-link text-decoration-none" asp-action="Index" asp-route-sortOrder="@bookedForSort">Booked For</a>
                                </th>
                                <th class="text-end">Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var table in Model.Items)
                            {
                                <tr>
                                    <td>@table.TableName</td>
                                    <td>@table.TableNumber</td>
                                    <td>@table.Username</td>
                                    <td>@FormatBookingDate(table.BookedForUtc)</td>
                                     <td class="text-end">
                                    <a asp-controller="TableBooking" asp-action="BookMe" asp-route-TableId="@table.TableId" class="btn btn-sm search-action-button-compact grid-action-button">Book</a>
                                        <form asp-controller="TableBooking" asp-action="DeleteBooking" method="post" class="d-inline">
                                            @Html.AntiForgeryToken()
                                            <input type="hidden" name="tableId" value="@table.TableId" /> 
                                            <button type="submit" class="btn btn-sm btn-outline-danger grid-action-button" onclick="return confirm('Are you sure you want to cancel the table booking?');">Cancel Booking</button> 
                                        </form>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
            @if (Model.TotalPages > 1)
            {
                <div class="d-flex justify-content-between align-items-center mt-4">
                    <span class="text-muted small">Page @Model.PageNumber of @Model.TotalPages</span>
                    <nav aria-label="Table booking pagination">
                        <ul class="pagination mb-0">
                            <li class="page-item @(Model.HasPreviousPage ? string.Empty : "disabled")">
                                <a class="page-link"
                                   asp-action="Index"
                                   asp-route-page="@(Model.PageNumber - 1)"
                                   asp-route-sortOrder="@currentSort">Previous</a>
                            </li>
                            @for (var pageNumber = 1; pageNumber <= Model.TotalPages; pageNumber++)
                            {
                                <li class="page-item @(pageNumber == Model.PageNumber ? "active" : string.Empty)">
                                    <a class="page-link"
                                       asp-action="Index"
                                       asp-route-page="@pageNumber"
                                       asp-route-sortOrder="@currentSort">@pageNumber</a>
                                </li>
                            }
                            <li class="page-item @(Model.HasNextPage ? string.Empty : "disabled")">
                                <a class="page-link"
                                   asp-action="Index"
                                   asp-route-page="@(Model.PageNumber + 1)"
                                   asp-route-sortOrder="@currentSort">Next</a>
                            </li>
                        </ul>
                    </nav>
                </div>
            }
        </div>
    </div>
</div>
