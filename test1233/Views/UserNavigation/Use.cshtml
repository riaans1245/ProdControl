@model test1233.Models.AppTokens

@{
    ViewData["Title"] = "Use Token";
}

<div class="container py-4" style="max-width: 720px;">
    <div class="card shadow-sm border-0">
        <div class="card-body p-4">
            <h1 class="h3 mb-3">Send Token</h1>
            <p class="text-muted">Send this token to the administrator through the API.</p>

            <dl class="row mb-4">
                <dt class="col-sm-3">Username</dt>
                <dd class="col-sm-9">@Model.Username</dd>

                <dt class="col-sm-3">User ID</dt>
                <dd class="col-sm-9">@Model.UserId</dd>

                <dt class="col-sm-3">Token</dt>
                <dd class="col-sm-9">@Model.Token</dd>

                <dt class="col-sm-3">Product</dt>
                <dd class="col-sm-9">
                    <span class="badge" style="background-color: #f2be63; color: #5c3600;">@Model.ProductName</span>
                </dd>
            </dl>

            <form method="post">
                @Html.AntiForgeryToken()
                <input type="hidden" name="TokenId" value="@Model.TokenId" />
                <input type="hidden" name="UserId" value="@Model.UserId" />
                <input type="hidden" name="Username" value="@Model.Username" />
                <input type="hidden" name="Token" value="@Model.Token" />
                <input type="hidden" name="ProductId" value="@Model.ProductId" />
                <input type="hidden" name="ProductName" value="@Model.ProductName" />
                <div class="d-flex gap-2">
                    <button asp-action="Use" type="submit" class="btn btn-danger">Send Token</button>
                    <a asp-action="UserTokenList" class="btn btn-outline-secondary">Cancel</a>
                </div>
            </form>
        </div>
    </div>
</div>
