@model test1233.Models.AppNotification

@{
    ViewData["Title"] = "Delete Token";
}

<div class="container py-4" style="max-width: 620px;">
    <div class="card shadow-sm border-0">
        <div class="card-body p-4">
            <h1 class="h3 mb-3">Delete Notification</h1>
            <p class="text-muted">Are you sure you want to delete this Notification?</p>

            <dl class="row mb-4">
                <dt class="col-sm-3">Notification</dt>
                <dd class="col-sm-9">@Model.Notification</dd>

                <dt class="col-sm-3">User</dt>
                <dd class="col-sm-9">@Model.UserName</dd>
            </dl>

            <form method="post">
                @Html.AntiForgeryToken()
                <input type="hidden" asp-for="NotificationId" />
                <div class="d-flex gap-2">
                    <button asp-action="Delete" type="submit" class="btn btn-outline-danger" onclick="return confirm('Are you sure you want to delete this item?');">Delete</button>
                    <a asp-action="Index" class="btn btn-outline-secondary clear-action-button">Cancel</a>
                </div>
            </form>
        </div>
    </div>
</div>
