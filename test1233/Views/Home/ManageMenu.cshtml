@model test1233.Models.MenuUploadViewModel

@{
    ViewData["Title"] = "Manage Menu";

    string FormatUploadDate(DateTime value) => value == default
        ? "Unknown upload date"
        : value.ToLocalTime().ToString("dd MMM yyyy HH:mm");
}

<div class="container py-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h1 class="h3 mb-1">Manage Menu</h1>
            <p class="text-muted mb-0">Upload a new JPG menu image for customers to view.</p>
        </div>
    </div>

    @if (TempData["MenuUploadSuccess"] is string successMessage)
    {
        <div class="alert alert-success shadow-sm" role="alert">
            @successMessage
        </div>
    }

    @if (TempData["MenuUploadError"] is string errorMessage)
    {
        <div class="alert alert-danger shadow-sm" role="alert">
            @errorMessage
        </div>
    }

    <div class="row g-4">
        <div class="col-lg-5">
            <div class="card shadow-sm border-0">
                <div class="card-body">
                    <form asp-action="ManageMenu" asp-controller="Home" method="post" enctype="multipart/form-data">
                        @Html.AntiForgeryToken()
                        <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

                        <div class="mb-3">
                            <label asp-for="MenuFile" class="form-label">Select menu image</label>
                            <input asp-for="MenuFile" type="file" accept=".jpg,.jpeg,image/jpeg" class="form-control" />
                            <span asp-validation-for="MenuFile" class="text-danger"></span>
                        </div>

                        <button type="submit" class="btn search-action-button">Upload Menu</button>
                    </form>
                </div>
            </div>
        </div>

        <div class="col-lg-7">
            <div class="card shadow-sm border-0">
                <div class="card-body border-bottom">
                    <h2 class="h5 mb-1">Active Menu</h2>
                    <p class="text-muted mb-0">This is the menu shown when admins or users open the Menu page.</p>
                </div>
                @if (Model.ActiveMenu is not null)
                {
                    <div class="card-body py-2 border-bottom bg-light small text-muted">
                        Uploaded: @FormatUploadDate(Model.ActiveMenu.UploadedAtUtc)
                    </div>
                    <img src="@Model.ActiveMenu.Path"
                         asp-append-version="true"
                         alt="Active Easy Eats menu"
                         class="img-fluid w-100" />
                }
                else
                {
                    <div class="card-body">
                        <p class="text-muted mb-0">No menu images have been uploaded yet.</p>
                    </div>
                }
            </div>
        </div>
    </div>

    <div class="card shadow-sm border-0 mt-4">
        <div class="card-body border-bottom">
            <h2 class="h5 mb-1">Menu History</h2>
            <p class="text-muted mb-0">Browse saved menus and choose which one should appear on the Menu page.</p>
        </div>
        <div class="card-body">
            @if (Model.Menus.Count == 0)
            {
                <p class="text-muted mb-0">No menu images have been uploaded yet.</p>
            }
            else
            {
                <div class="row g-3">
                    @foreach (var menu in Model.Menus)
                    {
                        <div class="col-sm-6 col-lg-4 col-xl-3">
                            <div class="border rounded-4 overflow-hidden bg-light h-100">
                                <div class="px-3 py-2 small text-muted border-bottom bg-white d-flex justify-content-between align-items-center gap-2">
                                    <span>Uploaded: @FormatUploadDate(menu.UploadedAtUtc)</span>
                                    @if (menu.IsSelected)
                                    {
                                        <span class="badge bg-success fs-6 px-3 py-2">Active</span>
                                    }
                                </div>
                                <img src="@menu.Path"
                                     asp-append-version="true"
                                     alt="Easy Eats menu"
                                     class="img-fluid w-100"
                                     style="max-height: 180px; object-fit: cover;" />
                                @if (!menu.IsSelected)
                                {
                                    <div class="p-3 bg-white border-top">
                                        <form asp-controller="Home" method="post">
                                            @Html.AntiForgeryToken()
                                            <input type="hidden" name="menuPath" value="@menu.Path" />
                                            <button asp-action="SelectMenu" type="submit" class="btn search-action-button w-100">Show This Menu</button>
                                        </form>
                                    </div>
                                }
                            </div>
                        </div>
                    }
                </div>
            }
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
