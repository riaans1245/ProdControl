@model test1233.Models.SalesReportViewModel

@{
    ViewData["Title"] = "Sales Report";
    Layout = "~/Views/Shared/_ReportLayout.cshtml";
}

<div class="container py-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h1 class="h3 mb-1">Sales Report</h1>
            <p class="text-muted mb-0">Review user-created orders from the frontend order list.</p>
        </div>
        <a asp-action="ExportSales" class="btn btn-success">Export to Excel</a>
    </div>

    <div class="card shadow-sm border-0">
        <div class="card-body">
            <div class="table-responsive">
                <table class="table table-striped align-middle mb-0">
                    <thead>
                            <tr>
                                <th>User</th>
                                <th>User Id</th>
                                <th>Order #</th>
                                <th>Placed</th>
                                <th>Name</th>
                                <th>Category</th>
                                <th>Quantity</th>
                                <th>Unit Price</th>
                                <th>Price</th>
                                <th>Status</th>
                            </tr>
                    </thead>
                    <tbody>
                        @foreach (var row in Model.Orders.Items)
                        {
                            <tr>
                                <td>@row.Username</td>
                                <td>@row.UserId</td>
                                <td>@row.OrderId</td>
                                <td>@row.PlacedAtUtc.ToLocalTime().ToString("dd MMM yyyy h:mm tt")</td>
                                <td>@row.Name</td>
                                <td>@row.CategoryName</td>
                                <td>@row.Quantity</td>
                                <td>@row.Price.ToString("C")</td>
                                <td>@row.LineTotal.ToString("C")</td>
                                <td>@(row.IsPaid ? "Paid" : "Pending")</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>






