@model test1233.Models.ContactUs

@{
    ViewData["Title"] = "Contact Us";
}

<div class="container py-4" style="max-width: 620px;">
    <div class="card shadow-sm border-0">
        <div class="card-body p-4">
            <h1 class="h3 mb-3">Contact Us</h1>
            <p class="mb-2">You are deleting Contact Us <strong>@Model.Name</strong>.</p>

            <form method="post">
                @Html.AntiForgeryToken()
                <input type="hidden" name="id" value="@Model.Id" />
                <div class="d-flex gap-2">
                    <button asp-action="Delete" type="submit" class="btn btn-outline-danger" onclick="return confirm('Are you sure you want to delete this item?');">Delete</button>
                    <a asp-action="ContactUs" class="btn btn-outline-secondary clear-action-button">Cancel</a>
                </div>
            </form>
        </div>
    </div>
</div>