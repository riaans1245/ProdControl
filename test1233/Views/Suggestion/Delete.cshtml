@model test1233.Models.AppSuggestion

@{
    ViewData["Title"] = "Delete Suggestion";
}

<div class="container py-4" style="max-width: 620px;">
    <div class="card shadow-sm border-0">
        <div class="card-body p-4">
            <h1 class="h3 mb-3">Delete Sugestion</h1>
            <p class="text-muted">Are you sure you want to delete this Sugestion?</p>
            
            <dl class="row mb-4">
                <dt class="col-sm-3">User name</dt>
                <dd class="col-sm-9">@Model.MyName</dd>

                <dt class="col-sm-3">Suggestion</dt>
                <dd class="col-sm-9">@Model.Suggestion</dd>
            </dl>
            
            <form asp-action="Delete" method="post">
                @Html.AntiForgeryToken()
                <input asp-for="SuggestId" type="hidden" />
                <div class="d-flex gap-2">
                    <button type="submit" class="btn btn-danger">Delete</button>
                    <a asp-action="Index" class="btn btn-outline-secondary">Cancel</a>
                </div>
            </form>
        </div>
    </div>
</div>


