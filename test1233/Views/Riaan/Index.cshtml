@inject Microsoft.AspNetCore.Antiforgery.IAntiforgery Antiforgery
@{
    Layout = "~/Views/Shared/_ReportLayout.cshtml";
    var antiForgeryToken = Antiforgery.GetAndStoreTokens(Context).RequestToken ?? string.Empty;
    var initialState = new
    {
        isAuthenticated = User.Identity?.IsAuthenticated == true,
        isAdmin = User.IsInRole("Admin"),
        username = User.Identity?.Name ?? string.Empty,
        loginUrl = Url.Action("DashboardLogin", "Riaan"),
        dashboardDataUrl = Url.Action("DashboardData", "Riaan"),
        returnUrl = Url.Action("Index", "Riaan"),
        antiForgeryToken,
        loginError = ViewData["DashboardLoginError"] as string ?? string.Empty
    };
}

<div class="eats-dashboard-page">
    <div id="eats-dashboard-root"></div>
</div>

@section Scripts {
    <script crossorigin src="https://unpkg.com/react@18/umd/react.development.js"></script>
    <script crossorigin src="https://unpkg.com/react-dom@18/umd/react-dom.development.js"></script>
    <script src="https://unpkg.com/@@babel/standalone/babel.min.js"></script>
    <script>
        window.eatsDashboardInitialState = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(initialState));
    </script>
    <script type="text/babel">
        const { useEffect, useMemo, useState } = React;
        const initialState = window.eatsDashboardInitialState;

        function formatDate(value) {
            if (!value) {
                return "-";
            }

            const parsedDate = new Date(value);
            if (Number.isNaN(parsedDate.getTime())) {
                return String(value);
            }

            return parsedDate.toLocaleString("en-NZ", {
                year: "numeric",
                month: "short",
                day: "numeric",
                hour: "numeric",
                minute: "2-digit"
            });
        }

        function formatCurrency(value) {
            const numericValue = Number(value ?? 0);
            return numericValue.toLocaleString("en-NZ", {
                style: "currency",
                currency: "NZD"
            });
        }

        function LoginScreen() {
            return (
                <div className="dashboard-shell">
                    <section className="dashboard-login-hero">
                        <div className="dashboard-login-copy">
                            <p className="dashboard-kicker">Token Monitor</p>
                            <h1>Eats Dashboard</h1>
                            <p>
                                Log in with your existing administrator password to view token API activity when users send tokens.
                            </p>
                            <div className="dashboard-note">
                                This uses the same admin credentials and authentication cookie already configured in the project.
                            </div>
                        </div>

                        <div className="dashboard-login-card">
                            <p className="dashboard-card-kicker">Administrator Login</p>
                            <h2>Sign in to continue</h2>
                            {initialState.loginError ? <div className="dashboard-error">{initialState.loginError}</div> : null}
                            <form action={initialState.loginUrl} method="post" className="dashboard-login-form">
                                <input type="hidden" name="__RequestVerificationToken" value={initialState.antiForgeryToken} />
                                <input type="hidden" name="returnUrl" value={initialState.returnUrl} />
                                <input type="hidden" name="RequestMagicLink" value="false" />

                                <div className="dashboard-field">
                                    <label htmlFor="dashboard-username">User name</label>
                                    <input id="dashboard-username" name="Username" type="text" required />
                                </div>
                                <div className="dashboard-field">
                                    <label htmlFor="dashboard-password">Password</label>
                                    <input id="dashboard-password" name="Password" type="password" required />
                                </div>
                                <label className="dashboard-check">
                                    <input name="RememberMe" type="checkbox" value="true" />
                                    <span>Remember me</span>
                                </label>
                                <input name="RememberMe" type="hidden" value="false" />
                                <button type="submit" className="dashboard-login-btn">Login to Eats Dashboard</button>
                            </form>
                        </div>
                    </section>
                </div>
            );
        }

        function AccessDeniedScreen() {
            return (
                <div className="dashboard-shell">
                    <section className="dashboard-panel">
                        <p className="dashboard-kicker">Access Required</p>
                        <h1>Eats Dashboard</h1>
                        <p>You are signed in, but only administrators can view token API activity here.</p>
                    </section>
                </div>
            );
        }

        function DashboardApp() {
            const [data, setData] = useState(null);
            const [loading, setLoading] = useState(true);
            const [error, setError] = useState("");
            const [query, setQuery] = useState("");
            const [dateFrom, setDateFrom] = useState("");
            const [dateTo, setDateTo] = useState("");

            useEffect(() => {
                let cancelled = false;

                async function load() {
                    try {
                        const response = await fetch(initialState.dashboardDataUrl, {
                            headers: { "Accept": "application/json" }
                        });

                        if (!response.ok) {
                            throw new Error("The token dashboard could not be loaded.");
                        }

                        const payload = await response.json();
                        if (!cancelled) {
                            setData(payload);
                        }
                    } catch (loadError) {
                        if (!cancelled) {
                            setError(loadError instanceof Error ? loadError.message : "The token dashboard could not be loaded.");
                        }
                    } finally {
                        if (!cancelled) {
                            setLoading(false);
                        }
                    }
                }

                load();
                return () => {
                    cancelled = true;
                };
            }, []);

            const filteredUsedTokens = useMemo(() => {
                if (!data) {
                    return [];
                }

                const search = query.trim().toLowerCase();
                const fromBoundary = dateFrom ? new Date(`${dateFrom}T00:00:00`) : null;
                const toBoundary = dateTo ? new Date(`${dateTo}T23:59:59.999`) : null;

                return (data.usedTokens ?? []).filter((row) => {
                    const rowDate = row.sentAtUtc ? new Date(row.sentAtUtc) : null;
                    const matchesSearch = !search || Object.values(row).some((value) =>
                        String(value ?? "").toLowerCase().includes(search)
                    );

                    const matchesFrom = !fromBoundary || (rowDate && rowDate >= fromBoundary);
                    const matchesTo = !toBoundary || (rowDate && rowDate <= toBoundary);

                    return matchesSearch && matchesFrom && matchesTo;
                });
            }, [data, query, dateFrom, dateTo]);

            if (loading) {
                return (
                    <div className="dashboard-shell">
                        <section className="dashboard-panel">
                            <p className="dashboard-kicker">Loading</p>
                            <h1>Eats Dashboard</h1>
                            <p>Loading token activity from the API.</p>
                        </section>
                    </div>
                );
            }

            if (error) {
                return (
                    <div className="dashboard-shell">
                        <section className="dashboard-panel">
                            <p className="dashboard-kicker">Error</p>
                            <h1>Eats Dashboard</h1>
                            <p>{error}</p>
                        </section>
                    </div>
                );
            }

            const usedTokens = data?.usedTokens ?? [];
            const issuedTokens = data?.issuedTokens ?? [];
            const currentOrders = data?.currentOrders ?? [];
            const latestToken = filteredUsedTokens[0] ?? data?.latestUsedToken;

            return (
                <div className="dashboard-shell">
                    <section className="dashboard-header">
                        <div>
                            <p className="dashboard-kicker">React Token Activity</p>
                            <h1>Eats Dashboard</h1>
                            <p>
                                Monitor token API sends only. This dashboard shows who sent a token, which token was sent,
                                and the related token identifiers and timestamps.
                            </p>
                        </div>
                        <div className="dashboard-meta">
                            <div><strong>Admin:</strong> {data.currentUser}</div>
                            <div><strong>Updated:</strong> {formatDate(data.generatedAtUtc)}</div>
                          
                        </div>
                    </section>

                    <section className="dashboard-summary-grid">
                        <article className="dashboard-summary-card summary-blue">
                            <p>Issued Tokens</p>
                            <strong>{data.summary.issuedTokenCount}</strong>
                        </article>
                        <article className="dashboard-summary-card summary-green">
                            <p>Used Tokens</p>
                            <strong>{data.summary.usedTokenCount}</strong>
                        </article>
                        <article className="dashboard-summary-card summary-amber">
                            <p>Users Who Sent</p>
                            <strong>{data.summary.uniqueUsersWithSentTokens}</strong>
                        </article>
                        <article className="dashboard-summary-card summary-rose">
                            <p>Latest Sent</p>
                            <strong>{formatDate(data.summary.latestTokenSentAtUtc)}</strong>
                        </article>
                        <article className="dashboard-summary-card summary-slate">
                            <p>Open Orders</p>
                            <strong>{data.summary.currentOpenOrderCount}</strong>
                        </article>
                        <article className="dashboard-summary-card summary-copper">
                            <p>Paid Orders</p>
                            <strong>{data.summary.paidOrderCount}</strong>
                        </article>
                        <article className="dashboard-summary-card summary-teal">
                            <p>People With Orders</p>
                            <strong>{data.summary.peopleWithOrders}</strong>
                        </article>
                        <article className="dashboard-summary-card summary-olive">
                            <p>Booked Tables</p>
                            <strong>{data.summary.bookedTableCount}</strong>
                        </article>
                    </section>

                    <section className="dashboard-grid">
                        <article className="dashboard-panel">
                            <p className="dashboard-kicker">Latest Activity</p>
                            <h2>Token sends in selected date range</h2>
                            {latestToken ? (
                                <div className="dashboard-activity-list">
                                    {filteredUsedTokens.slice(0, 6).map((token) => (
                                        <div className="dashboard-activity-item" key={token.id}>
                                            <div className="dashboard-activity-main">
                                                <strong>User: {token.username}</strong>
                                                <span>Token: {token.token}</span>
                                            </div>
                                            <div className="dashboard-activity-meta">
                                                <span className="dashboard-product-badge">{token.productName || "No product"}</span>
                                                <span>{formatDate(token.sentAtUtc)}</span>
                                            </div>
                                        </div>
                                    ))}
                                </div>
                            ) : (
                                <p className="dashboard-empty">No token activity matches the current search and date range.</p>
                            )}
                        </article>

                        <article className="dashboard-panel">
                            <div className="dashboard-panel-head">
                                <div>
                                    <p className="dashboard-kicker">Filters</p>
                                    <h2>Filter used token activity</h2>
                                </div>
                            </div>
                            <input
                                className="dashboard-search"
                                type="search"
                                value={query}
                                onChange={(event) => setQuery(event.target.value)}
                                placeholder="Search by user, or date"
                            />
                            <div className="dashboard-date-grid">
                                <div className="dashboard-field-inline">
                                    <label htmlFor="dashboard-date-from">Date From</label>
                                    <input
                                        id="dashboard-date-from"
                                        type="date"
                                        value={dateFrom}
                                        onChange={(event) => setDateFrom(event.target.value)}
                                    />
                                </div>
                                <div className="dashboard-field-inline">
                                    <label htmlFor="dashboard-date-to">Date To</label>
                                    <input
                                        id="dashboard-date-to"
                                        type="date"
                                        value={dateTo}
                                        onChange={(event) => setDateTo(event.target.value)}
                                    />
                                </div>
                            </div>
                            <p className="dashboard-help">This table only shows tokens that were actually sent through the API.</p>
                        </article>
                    </section>

                    <section className="dashboard-panel">
                        <div className="dashboard-panel-head">
                            <div>
                                <p className="dashboard-kicker">Orders And Tables</p>
                                <h2>Paid, open, and booked table details per person</h2>
                            </div>
                            <span className="dashboard-pill">{currentOrders.length} people</span>
                        </div>
                        {currentOrders.length === 0 ? (
                            <div className="dashboard-empty">There are no orders or booked tables to show right now.</div>
                        ) : (
                            <div className="dashboard-person-grid">
                                {currentOrders.map((person) => (
                                    <article className="dashboard-person-card" key={person.userId}>
                                        <div className="dashboard-person-head">
                                            <div>
                                                <h3>{person.userFullName || person.username}</h3>
                                                <p>{String.fromCharCode(64)}{person.username}</p>
                                            </div>
                                            <span className="dashboard-product-badge">{person.userRole || "User"}</span>
                                        </div>
                                        <div className="dashboard-person-meta">
                                            <span>{person.userEmailAddress || "No email"}</span>
                                            <span>{person.userCellNo || "No cell number"}</span>
                                        </div>
                                        <div className="dashboard-person-meta">
                                            <span>{person.hasTableBooking ? `${person.tableBookings.length} booked table(s)` : "No table booking"}</span>
                                        </div>
                                        <div className="dashboard-person-stats">
                                            <div><strong>{person.totalOrders}</strong><span>Total Orders</span></div>
                                            <div><strong>{person.totalOpenOrders}</strong><span>Open Orders</span></div>
                                            <div><strong>{person.totalPaidOrders}</strong><span>Paid Orders</span></div>
                                            <div><strong>{person.totalItems}</strong><span>Items</span></div>
                                            <div><strong>{formatCurrency(person.totalValue)}</strong><span>Total Value</span></div>
                                        </div>
                                        {person.hasTableBooking ? (
                                            <div className="dashboard-booking-list">
                                                {person.tableBookings.map((table) => (
                                                    <div className="dashboard-booking-card" key={table.tableId}>
                                                        <strong>{table.tableName}</strong>
                                                        <span>Table #{table.tableNumber}</span>
                                                        <span>{formatDate(table.bookedForUtc)}</span>
                                                    </div>
                                                ))}
                                            </div>
                                        ) : null}
                                        <div className="dashboard-order-stack">
                                            {person.orders.map((order) => (
                                                <div className="dashboard-order-card" key={order.orderId}>
                                                    <div className="dashboard-order-head">
                                                        <div className="dashboard-order-title">
                                                            <strong>Order #{order.orderId}</strong>
                                                            <span className={`dashboard-status-badge ${order.isPaid ? "is-paid" : "is-open"}`}>{order.paymentStatus}</span>
                                                        </div>
                                                        <span>{formatDate(order.placedAtUtc)}</span>
                                                    </div>
                                                    <div className="dashboard-order-summary">
                                                        <span>{order.itemCount} items</span>
                                                        <span>{formatCurrency(order.orderTotal)}</span>
                                                    </div>
                                                    {order.appliedTokens.length > 0 ? (
                                                        <div className="dashboard-order-discount">
                                                            <span>Receipt {order.receiptNumber || "-"}</span>
                                                            <span>Token discount {formatCurrency(order.tokenDiscountTotal * -1)}</span>
                                                            <strong>Reduced total {formatCurrency(order.reducedOrderTotal)}</strong>
                                                        </div>
                                                    ) : null}
                                                    <div className="dashboard-table-wrap">
                                                        <table className="dashboard-table dashboard-table-compact">
                                                            <thead>
                                                                <tr>
                                                                    <th>Product</th>
                                                                    <th>Category</th>
                                                                    <th>Qty</th>
                                                                    <th>Price</th>
                                                                    <th>Line Total</th>
                                                                    <th>Token</th>
                                                                    <th>Reduced Price</th>
                                                                </tr>
                                                            </thead>
                                                            <tbody>
                                                                {order.items.map((item, index) => (
                                                                    <tr key={`${order.orderId}-${item.productId}-${index}`}>
                                                                        <td>{item.name}</td>
                                                                        <td>{item.categoryName}</td>
                                                                        <td>{item.quantity}</td>
                                                                        <td>{formatCurrency(item.price)}</td>
                                                                        <td>{formatCurrency(item.lineTotal)}</td>
                                                                        <td>
                                                                            {item.appliedTokens.length === 0 ? (
                                                                                <span>-</span>
                                                                            ) : (
                                                                                <div className="dashboard-token-stack">
                                                                                    {item.appliedTokens.map((token) => (
                                                                                        <span className="dashboard-token-badge" key={`${order.orderId}-${token.tokenId}`}>
                                                                                            {token.token}
                                                                                        </span>
                                                                                    ))}
                                                                                </div>
                                                                            )}
                                                                        </td>
                                                                        <td>
                                                                            {item.tokenDiscount > 0 ? (
                                                                                <div className="dashboard-reduced-price">
                                                                                    <span className="dashboard-reduced-discount">{formatCurrency(item.tokenDiscount * -1)}</span>
                                                                                    <strong>{formatCurrency(item.reducedLineTotal)}</strong>
                                                                                </div>
                                                                            ) : (
                                                                                <span>{formatCurrency(item.lineTotal)}</span>
                                                                            )}
                                                                        </td>
                                                                    </tr>
                                                                ))}
                                                            </tbody>
                                                        </table>
                                                    </div>
                                                </div>
                                            ))}
                                        </div>
                                    </article>
                                ))}
                            </div>
                        )}
                    </section>

                    <section className="dashboard-panel">
                        <div className="dashboard-panel-head">
                            <div>
                                <p className="dashboard-kicker">API Activity</p>
                                <h2>Used token records</h2>
                            </div>
                            <span className="dashboard-pill">{filteredUsedTokens.length} records</span>
                        </div>
                        {filteredUsedTokens.length === 0 ? (
                            <div className="dashboard-empty">No User token activity was found.</div>
                        ) : (
                            <div className="dashboard-table-wrap">
                                <table className="dashboard-table">
                                    <thead>
                                        <tr>
                                            <th>Record Id</th>
                                            <th>User</th>
                                            <th>Full Name</th>
                                            <th>Email</th>
                                            <th>Cell</th>
                                            <th>Role</th>
                                            <th>Token</th>
                                            <th>Product</th>
                                            <th>Sent At</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        {filteredUsedTokens.map((row) => (
                                            <tr key={row.id}>
                                                <td>{row.id}</td>
                                                <td>{row.username}</td>
                                                <td>{row.userFullName || "-"}</td>
                                                <td>{row.userEmailAddress || "-"}</td>
                                                <td>{row.userCellNo || "-"}</td>
                                                <td>{row.userRole || "-"}</td>
                                                <td>{row.token}</td>
                                                <td><span className="dashboard-product-badge">{row.productName || "No product"}</span></td>
                                                <td>{formatDate(row.sentAtUtc)}</td>
                                            </tr>
                                        ))}
                                    </tbody>
                                </table>
                            </div>
                        )}
                    </section>

                    <section className="dashboard-panel">
                        <div className="dashboard-panel-head">
                            <div>
                                <p className="dashboard-kicker">Reference</p>
                                <h2>Issued token list</h2>
                            </div>
                            <span className="dashboard-pill">{issuedTokens.length} tokens</span>
                        </div>
                        {issuedTokens.length === 0 ? (
                            <div className="dashboard-empty">No issued tokens are created yet.</div>
                        ) : (
                            <div className="dashboard-table-wrap">
                                <table className="dashboard-table">
                                    <thead>
                                        <tr>
                                            <th>Token Id</th>
                                            <th>User</th>
                                            <th>Full Name</th>
                                            <th>Email</th>
                                            <th>Cell</th>
                                            <th>Role</th>
                                            <th>Token</th>
                                            <th>Product</th>
                                            <th>TOKEN IS USED</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        {issuedTokens.map((row) => (
                                            <tr key={row.tokenId}>
                                                <td>{row.tokenId}</td>
                                                <td>{row.username}</td>
                                                <td>{row.userFullName || "-"}</td>
                                                <td>{row.userEmailAddress || "-"}</td>
                                                <td>{row.userCellNo || "-"}</td>
                                                <td>{row.userRole || "-"}</td>
                                                <td>{row.token}</td>
                                                <td><span className="dashboard-product-badge">{row.productName || "No product"}</span></td>
                                                <td>{row.hasBeenSent ? "Yes" : "No"}</td>
                                            </tr>
                                        ))}
                                    </tbody>
                                </table>
                            </div>
                        )}
                    </section>
                </div>
            );
        }

        function App() {
            if (!initialState.isAuthenticated) {
                return <LoginScreen />;
            }

            if (!initialState.isAdmin) {
                return <AccessDeniedScreen />;
            }

            return <DashboardApp />;
        }

        ReactDOM.createRoot(document.getElementById("eats-dashboard-root")).render(<App />);
    </script>
    <style>
        .eats-dashboard-page {
            min-height: 100%;
        }

        .dashboard-shell {
            display: grid;
            gap: 1.35rem;
            color: #dbe9f5;
        }

        .dashboard-login-hero,
        .dashboard-header,
        .dashboard-panel {
            border: 1px solid rgba(92, 123, 149, 0.48);
            border-radius: 1.6rem;
            padding: 1.75rem;
            background:
                radial-gradient(circle at top right, rgba(214, 151, 77, 0.16), transparent 24%),
                linear-gradient(135deg, rgba(13, 24, 34, 0.98) 0%, rgba(24, 40, 55, 0.98) 100%);
            box-shadow: 0 18px 38px rgba(3, 10, 18, 0.3);
        }

        .dashboard-login-hero {
            display: grid;
            grid-template-columns: minmax(0, 1.1fr) minmax(320px, 420px);
            gap: 1.5rem;
            align-items: center;
        }

        .dashboard-kicker,
        .dashboard-card-kicker {
            margin: 0 0 0.45rem;
            color: #e5ae69;
            font-size: 0.76rem;
            font-weight: 800;
            letter-spacing: 0.14em;
            text-transform: uppercase;
        }

        .dashboard-login-copy h1,
        .dashboard-header h1,
        .dashboard-panel h1 {
            margin: 0 0 0.75rem;
            font-size: clamp(2rem, 3vw, 3rem);
            line-height: 1.04;
            color: #f2f8fd;
        }

        .dashboard-login-copy p,
        .dashboard-header p,
        .dashboard-panel p,
        .dashboard-help {
            margin: 0;
            color: #abc0d3;
            line-height: 1.65;
        }

        .dashboard-note,
        .dashboard-meta {
            margin-top: 1rem;
            padding: 0.95rem 1rem;
            border-radius: 1rem;
            background: rgba(8, 18, 27, 0.8);
            border: 1px solid rgba(92, 123, 149, 0.45);
            color: #d2e3f1;
        }

        .dashboard-login-card {
            padding: 1.5rem;
            border-radius: 1.4rem;
            background: linear-gradient(160deg, #0a1823 0%, #15354b 100%);
            color: #f5fbff;
        }

        .dashboard-login-card h2 {
            margin: 0 0 1rem;
            color: #ffffff;
            font-size: 1.55rem;
        }

        .dashboard-login-form {
            display: grid;
            gap: 0.9rem;
        }

        .dashboard-error {
            margin-bottom: 1rem;
            padding: 0.8rem 0.9rem;
            border-radius: 0.9rem;
            background: rgba(187, 70, 70, 0.2);
            border: 1px solid rgba(248, 174, 174, 0.32);
            color: #ffe2e2;
        }

        .dashboard-field label {
            display: block;
            margin-bottom: 0.35rem;
            color: #d9e9f3;
            font-weight: 600;
        }

        .dashboard-field input,
        .dashboard-search {
            width: 100%;
            border: 1px solid rgba(109, 141, 167, 0.52);
            border-radius: 0.9rem;
            padding: 0.9rem 1rem;
            background: rgba(7, 16, 24, 0.94);
            color: #edf6fd;
        }

        .dashboard-check {
            display: flex;
            align-items: center;
            gap: 0.55rem;
            color: #deebf3;
        }

        .dashboard-login-btn {
            border: 0;
            border-radius: 999px;
            padding: 0.95rem 1.15rem;
            background: linear-gradient(135deg, #efbc73 0%, #d67f41 100%);
            color: #20262d;
            font-weight: 800;
        }

        .dashboard-header {
            display: flex;
            justify-content: space-between;
            gap: 1rem;
            align-items: end;
        }

        .dashboard-grid,
        .dashboard-summary-grid {
            display: grid;
            gap: 1rem;
            grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
        }

        .dashboard-summary-card {
            min-height: 132px;
            border-radius: 1.35rem;
            padding: 1.15rem;
            color: #f7fbff;
            box-shadow: 0 16px 34px rgba(18, 34, 50, 0.12);
        }

