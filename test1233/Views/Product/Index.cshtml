@model test1233.Models.PagedListViewModel<test1233.Models.AppProduct>

@{
    ViewData["Title"] = "Products";
    var currentSearch = ViewData["CurrentSearch"] as string ?? string.Empty;
}

<div class="container py-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h1 class="h3 mb-1">Product Management</h1>
            <p class="text-muted mb-0">Manage products and link each one to a category.</p>
        </div>
        <a asp-action="Create" class="btn text-white" style="background-color: #080808; color: #123246;">Add Product</a>
    </div>

<form asp-action="Index" method="get" class="row g-2 align-items-end mb-4">
        <div class="col-sm-8 col-md-6 col-lg-4">
            <label for="searchString" class="form-label">Search categories</label>
            <input id="searchString"
                   name="searchString"
                   value="@currentSearch"
                   class="form-control"
                   placeholder="Search by Product and Category name" />
        </div>
        <div class="col-auto">
            <button type="submit" class="btn btn-dark">Search</button>
        </div>
        <div class="col-auto">
            <a asp-action="Index" class="btn btn-outline-secondary">Clear</a>
        </div>
    </form>


    <div class="card shadow-sm border-0">
        <div class="card-body">
             @if (Model.Items.Count == 0)
            {
                <div class="text-muted">
                    No users found@(string.IsNullOrWhiteSpace(currentSearch) ? "." : $" for \"{currentSearch}\".").
                </div>
            }
            else
            {
                <div class="table-responsive">
                    <table class="table table-striped align-middle mb-0">
                        <thead>
                            <tr>
                                @* <th>Id</th> *@
                                <th>Product</th>
                                <th>Price</th>
                                <th>Category</th>
                                <th class="text-end">Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                        @foreach (var product in Model.Items)
                        {
                            <tr>
                                @* <td>@product.Id</td> *@
                                <td>@product.Name</td>
                                <td>@product.Price.ToString("C")</td>
                                <td>@product.CategoryName</td>
                                <td class="text-end">
                                    <a asp-action="Edit" asp-route-id="@product.Id" class="btn btn-sm btn-outline-secondary">Edit</a>
                                    <a asp-action="Delete" asp-route-id="@product.Id" class="btn btn-sm btn-outline-danger">Delete</a>
                                </td>
                            </tr>
                        }
                        </tbody>
                    </table>
                </div>
            }
            <div class="d-flex justify-content-between align-items-center mt-4">
                <span class="text-muted small">Page @Model.PageNumber of @Model.TotalPages</span>
                <nav aria-label="Product pagination">
                    <ul class="pagination mb-0">
                        <li class="page-item @(Model.HasPreviousPage ? string.Empty : "disabled")">
                            <a class="page-link" asp-action="Index" asp-route-page="@(Model.PageNumber - 1)">Previous</a>
                        </li>
                        @for (var pageNumber = 1; pageNumber <= Model.TotalPages; pageNumber++)
                        {
                            <li class="page-item @(pageNumber == Model.PageNumber ? "active" : string.Empty)">
                                <a class="page-link" asp-action="Index" asp-route-page="@pageNumber">@pageNumber</a>
                            </li>
                        }
                        <li class="page-item @(Model.HasNextPage ? string.Empty : "disabled")">
                            <a class="page-link" asp-action="Index" asp-route-page="@(Model.PageNumber + 1)">Next</a>
                        </li>
                    </ul>
                </nav>
            </div>
        </div>
    </div>
</div>
