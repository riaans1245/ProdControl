@model IReadOnlyCollection<test1233.Models.AppNotification>

@{
    ViewData["Title"] = "Notifications";
}

<div class="container py-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h1 class="h3 mb-1">Notifications Management</h1>
            <p class="text-muted mb-0">Manage notifications and link each one to a user.</p>
        </div>
        <a asp-action="Create" class="btn text-white" style="background-color: #080808; color: #123246;">Add Notifications</a>
    </div>

    <div class="card shadow-sm border-0">
        <div class="card-body">
            <div class="table-responsive">
                <table class="table table-striped align-middle mb-0">
                    <thead>
                        <tr>
                            <th>NotificationsId</th>
                            <th>Notification</th>
                            <th>User</th>
                            <th class="text-end">Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                    @foreach (var notifications in Model)
                    {
                        <tr>
                            <td>@notifications.NotificationId</td>
                            <td>@notifications.Notification</td>
                            <td>@notifications.UserName</td>
                            <td class="text-end">
                                <a asp-action="Edit" asp-route-id="@notifications.NotificationId" class="btn btn-sm btn-outline-secondary">Edit</a>
                                <a asp-action="Delete" asp-route-id="@notifications.NotificationId" class="btn btn-sm btn-outline-danger">Delete</a>
                            </td>
                        </tr>
                    }
                    </tbody>
                </table>
            </div>

        </div>
    </div>
</div>