
@model test1233.Models.PagedListViewModel<test1233.Models.AppTables>

@{
    ViewData["Title"] = "Table Booking";
    string FormatBookingDate(DateTime? value) =>
        value.HasValue ? value.Value.ToString("dd MMM yyyy HH:mm") : "Not booked";
}

<div class="container py-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h1 class="h3 mb-1">Table Management</h1>
            <p class="text-muted mb-0">Manage table bookings and link each one to a user.</p>
        </div>
        <div class="d-flex gap-2 align-items-center">
           <a asp-controller="Table" asp-action="Index" class="btn btn-outline-secondary">Back</a>
        </div>
    </div>

    <div class="card shadow-sm border-0">
        <div class="card-body">
            @if (Model.Items.Count == 0)
            {
                <div class="alert alert-light border mb-0">No tables are available yet.</div>
            }
            else
            {
                <div class="table-responsive">
                    <table class="table table-striped align-middle mb-0">
                        <thead>
                            <tr>
                                <th>Table Name</th>
                                <th>Table Number</th>
                                <th>User</th>
                                <th>Booked For</th>
                                <th class="text-end">Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var table in Model.Items)
                            {
                                <tr>
                                    <td>@table.TableName</td>
                                    <td>@table.TableNumber</td>
                                    <td>@table.Username</td>
                                    <td>@FormatBookingDate(table.BookedForUtc)</td>
                                     <td class="text-end">
                                    <a asp-controller="TableBooking" asp-action="BookMe" asp-route-TableId="@table.TableId" class="btn btn-sm btn-outline-secondary">Book</a>
                                        <form asp-controller="TableBooking" asp-action="DeleteBooking" method="post" class="d-inline">
                                            @Html.AntiForgeryToken()
                                            <input type="hidden" name="tableId" value="@table.TableId" /> 
                                            <button type="submit" class="btn btn-sm btn-danger" onclick="return confirm('Are you sure you want to cancel the table booking?');">Cancel Booking</button> 
                                        </form>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        </div>
    </div>
</div>
