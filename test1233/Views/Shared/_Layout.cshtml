@inject test1233.Services.IUserStore UserStore

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Easy Eats</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/test1233.styles.css" asp-append-version="true" />
    <script>
        (() => {
            if (sessionStorage.getItem("admin-left-nav-collapsed") === "true") {
                document.documentElement.classList.add("admin-left-nav-collapsed-state");
            }
        })();
    </script>
    <style>
        .app-shell {
            min-height: 0;
        }

        .left-nav-toggle-btn {
            border: 1px solid rgba(214, 226, 239, 0.34);
            background-color: transparent;
        }

        .topbar-action-button {
            border: 1px solid rgba(214, 226, 239, 0.34);
            border-radius: 0.375rem;
            background: rgba(255, 255, 255, 0.06);
            color: #edf4fb;
            display: inline-flex;
            align-items: center;
            justify-content: center;
            font-size: 0.95rem;
            line-height: 1.2;
            min-height: 38px;
            padding: 0.45rem 0.85rem;
            text-decoration: none;
            white-space: nowrap;
        }

        .topbar-action-button:hover,
        .topbar-action-button:focus {
            color: #ffffff;
            background: rgba(255, 255, 255, 0.14);
            text-decoration: none;
        }

        .left-nav-toggle-btn:focus,
        .left-nav-toggle-btn:active,
        .topbar-action-button:focus,
        .topbar-action-button:active {
            box-shadow: none;
            outline: none;
        }
    </style>
</head>
<body class="admin-shell d-flex flex-column min-vh-100 m-0">
    @{
        var isAdmin = User.IsInRole("Admin");
        var hasUsedTokens = (bool?)ViewBag.HasUsedTokens == true;
    }
    
    <!-- Top Navigation Bar --> 
    <nav class="navbar navbar-expand-md navbar-dark border-bottom shadow-sm py-3 admin-topbar"> 
        <div class="container-fluid"> 
            @if (isAdmin)
            {
                <button id="admin-left-nav-toggle"
                        type="button"
                        class="navbar-toggler me-3 d-inline-flex left-nav-toggle-btn"
                        aria-label="Toggle admin navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>
            }
            <a class="navbar-brand fw-bold" asp-controller="Home" asp-action="Index">Easy Eats Admin</a> 
            @if (hasUsedTokens)
            {
                <a asp-controller="Token"
                   asp-action="Used"
                   class="btn fw-semibold"
                   style="background-color: #d8f3dc; border-color: #b7e4c7; color: #1f4d2f;">Available Tokens</a>
            }
            else
            {
                <a asp-controller="Token"
                   asp-action="Used"
                   class="btn btn-outline-secondary">No Tokens</a>
            }
           
            <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target=".navbar-collapse" aria-controls="navbarSupportedContent" aria-expanded="false" aria-label="Toggle navigation"> 
                <span class="navbar-toggler-icon">

                </span> 
            </button> 
        <div class="navbar-collapse collapse d-md-inline-flex justify-content-end"> 
            <!-- Topbar Right Authentication Controls --> 
            <ul class="navbar-nav align-items-center gap-2"> 
                @if (User.Identity?.IsAuthenticated == true) 
                { 
                    <li class="nav-item"> 
                        <label name=lblUserInfo class="fw-semibold me-2">Welcome, @User.Identity.Name!</label>
                    </li> 
                    <li class="nav-item"> 
                        <form class="m-0" asp-controller="Account" asp-action="Logout" method="post"> 
                            @Html.AntiForgeryToken() 
                            <button type="submit" class="btn topbar-action-button fw-semibold">Logout</button> 
                        </form> 
                    </li> 
                    } 
                    else 
                    { 
                        <li class="nav-item"> 
                            @* <a class="nav-link text-white px-3" asp-controller="Account" asp-action="Register">Register</a>  *@
                        </li> 
                        <li class="nav-item"> 
                            <a class="nav-link text-white px-3" asp-controller="Account" asp-action="Login">Login</a> 
                        </li> 
                    } 
                    </ul> 
                </div> 
            </div> 
        </nav> 
    <!-- Main Workspace Container --> 
    <div class="d-flex flex-grow-1 align-items-stretch app-shell"> 
        @if (isAdmin)
        {
            <aside class="flex-shrink-0 app-sidebar" id="admin-left-navigation">
                <nav class="p-4 shadow-sm h-100 admin-sidebar-nav">
                    <div class="admin-sidebar-scroll">
                        <div class="border rounded-4 p-3 mb-4 sidebar-heading-card admin-sidebar-card">
                            <p class="mb-2 admin-sidebar-kicker">Navigation</p>
                            <p class="mb-1 fw-semibold admin-sidebar-title">Admin menu</p>
                            <p class="mb-0 admin-sidebar-copy">Move through pages and reports without crowding the top bar.</p>
                        </div>
                        <div class="left-nav-gallery-panel">
                            <a class="left-nav-gallery-card left-nav-gallery-card-home" 
                                asp-controller="Home" title="Home" aria-label="Home" asp-action="Index">
                                <span class="left-nav-gallery-icon" aria-hidden="true"></span>
                                <span class="left-nav-gallery-label">Home</span>
                            </a>
                            <a class="left-nav-gallery-card left-nav-gallery-card-users" 
                                asp-controller="User" title="Users" aria-label="Users" asp-action="Index">
                                <span class="left-nav-gallery-icon" aria-hidden="true"></span>
                                <span class="left-nav-gallery-label">Users</span>
                            </a>
                            <a class="left-nav-gallery-card left-nav-gallery-card-roles" 
                                asp-controller="Role" title="Roles" aria-label="Roles" asp-action="Index">
                                <span class="left-nav-gallery-icon" aria-hidden="true"></span>
                                <span class="left-nav-gallery-label">Roles</span>
                            </a>
                             <a class="left-nav-gallery-card left-nav-gallery-card-categories" 
                                asp-controller="Category" title="Categories" aria-label="Categories" asp-action="Index">
                                <span class="left-nav-gallery-icon" aria-hidden="true"></span>
                                <span class="left-nav-gallery-label">Categories</span>
                            </a>
                            <a class="left-nav-gallery-card left-nav-gallery-card-products" 
                                asp-controller="Product" title="Products" aria-label="Products" asp-action="Index">
                                <span class="left-nav-gallery-icon" aria-hidden="true"></span>
                                <span class="left-nav-gallery-label">Products</span>
                            </a>
                            <a class="left-nav-gallery-card left-nav-gallery-card-products" 
                                asp-controller="ProductIng" title="ProductIngredients" aria-label="Product Ingredients" asp-action="Index">
                                <span class="left-nav-gallery-icon" aria-hidden="true"></span>
                                <span class="left-nav-gallery-label">Product Ingredients</span>
                            </a>
                            <a class="left-nav-gallery-card left-nav-gallery-card-menu" 
                                asp-controller="Home" title="Our Menu" aria-label="Our Menu" asp-action="ManageMenu">
                                <span class="left-nav-gallery-icon" aria-hidden="true"></span>
                                <span class="left-nav-gallery-label">Our Menu</span>
                            </a>
                            <a class="left-nav-gallery-card left-nav-gallery-card-suggestions" 
                                asp-controller="Suggestion" title="Suggestions" aria-label="Suggestions" asp-action="Index">
                                <span class="left-nav-gallery-icon" aria-hidden="true"></span>
                                <span class="left-nav-gallery-label">Suggestions</span>
                            </a>
                            <a class="left-nav-gallery-card left-nav-gallery-card-notifications" 
                                asp-controller="Notification" title="Notifications" aria-label="Notifications" asp-action="Index">
                                <span class="left-nav-gallery-icon" aria-hidden="true"></span>
                                <span class="left-nav-gallery-label">Notifications</span>
                            </a>
                            <a class="left-nav-gallery-card left-nav-gallery-card-tokens" 
                                asp-controller="Token" title="Tokens" aria-label="Tokens" asp-action="Index">
                                <span class="left-nav-gallery-icon" aria-hidden="true"></span>
                                <span class="left-nav-gallery-label">Tokens</span>
                            </a>
                            <a class="left-nav-gallery-card left-nav-gallery-card-table" 
                                asp-controller="Table" title="My Table" aria-label="My Table" asp-action="Index">
                                <span class="left-nav-gallery-icon" aria-hidden="true"></span>
                                <span class="left-nav-gallery-label">Tables</span>
                            </a>
                        </div>
                    </div>
                    <hr class="admin-nav-divider" />
                    <div class="left-nav-gallery-panel">
                        <a class="left-nav-gallery-card left-nav-gallery-card-roles" 
                            asp-controller="Reports" title="Reports" aria-label="Reports" asp-action="Index">
                            <span class="left-nav-gallery-icon" aria-hidden="true"></span>
                            <span class="left-nav-gallery-label">Report</span>
                        </a>
                        <h6 class="mb-0 admin-sidebar-copy">Eats Dashboard - https://localhost:7084/Riaan</h6>
                    </div>
                </nav>
            </aside>
        }
        <!-- Dynamic Main View Content Area --> 
        <main role="main" class="flex-grow-1 p-0 overflow-auto admin-content"> 
            <div class="admin-content-surface">
                @RenderBody()
            </div>
        </main> 
    </div> 
    <!-- Footer Area --> 
    <footer class="footer border-top mt-auto shadow-sm admin-footer" style="height: 55px;"> 
        <div class="container-fluid d-flex justify-content-between align-items-center h-100 px-4"> 
            <ul class="nav"> 
                <li class="nav-item"> 
                    <span class="nav-link text-white px-3">Created by Riaan</span> 
                </li> 
            </ul> 
            <div class="footer-social-links" aria-label="Social media links">
                <a class="footer-social-link" href="#" aria-label="Facebook">
                    <span class="footer-social-icon footer-social-icon-facebook" aria-hidden="true"></span>
                </a>
                <a class="footer-social-link" href="#" aria-label="Twitter">
                    <span class="footer-social-icon footer-social-icon-twitter" aria-hidden="true"></span>
                </a>
            </div>
        </div> 
    </footer>
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script>
        (() => {
            const leftNavigation = document.getElementById("admin-left-navigation");
            const leftNavToggle = document.getElementById("admin-left-nav-toggle");

            if (!leftNavigation || !leftNavToggle) {
                return;
            }

            const syncButtonState = () => {
                const isExpanded = !leftNavigation.classList.contains("app-sidebar-collapsed");
                leftNavToggle.setAttribute("aria-expanded", isExpanded ? "true" : "false");
                leftNavToggle.setAttribute("title", isExpanded ? "Hide admin menu" : "Show admin menu");
            };

            const mobileMediaQuery = window.matchMedia("(max-width: 991.98px)");

            const applyInitialState = () => {
                const savedState = sessionStorage.getItem("admin-left-nav-collapsed");
                const shouldCollapse = savedState !== null
                    ? savedState === "true"
                    : mobileMediaQuery.matches;

                leftNavigation.classList.toggle("app-sidebar-collapsed", shouldCollapse);
                document.documentElement.classList.toggle("admin-left-nav-collapsed-state", shouldCollapse);
                syncButtonState();
            };

            leftNavToggle.addEventListener("click", () => {
                leftNavigation.classList.toggle("app-sidebar-collapsed");
                const isCollapsed = leftNavigation.classList.contains("app-sidebar-collapsed");
                sessionStorage.setItem("admin-left-nav-collapsed", isCollapsed ? "true" : "false");
                document.documentElement.classList.toggle("admin-left-nav-collapsed-state", isCollapsed);
                syncButtonState();
            });

            if (typeof mobileMediaQuery.addEventListener === "function") {
                mobileMediaQuery.addEventListener("change", applyInitialState);
            } else if (typeof mobileMediaQuery.addListener === "function") {
                mobileMediaQuery.addListener(applyInitialState);
            }

            applyInitialState();
        })();
    </script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
