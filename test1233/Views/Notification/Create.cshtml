@model test1233.Models.NotifiFormViewModel

@{
    ViewData["Title"] = "Create Token";
}

<div class="container py-4" style="max-width: 620px;">
    <div class="card shadow-sm border-0">
        <div class="card-body p-4">
            <h1 class="h3 mb-3">Create Notification</h1>

            <form method="post" class="notification-create-form">
                @Html.AntiForgeryToken()
                <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

                <div class="mb-3">
                    <label asp-for="Notification" class="form-label"></label>
                    <input asp-for="Notification" class="form-control" />
                    <span asp-validation-for="Notification" class="text-danger"></span>
                </div>
            
                <div class="form-check">
                     <label asp-for="AllUsers" class="form-check-label">All Users</label>
                    <input type="checkbox" class="form-check-input" asp-for="AllUsers" />
                </div>

                <div class="mb-4" id="user-select-wrapper">
                    <label asp-for="UserId" class="form-label"></label>
                    <select asp-for="UserId" asp-items="Model.AvailableUsers" class="form-select"></select>
                    <span asp-validation-for="UserId" class="text-danger"></span>
                </div>
            
                <div class="d-flex gap-2">
                    <button asp-action="Create" type="submit" class="btn btn-dark">Save</button>
                    <a asp-action="Index" class="btn btn-outline-secondary">Cancel</a>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}

<style>
    .notification-create-form:has(#AllUsers:checked) #user-select-wrapper {
        display: none;
    }
</style>
