@model test1233.Models.PagedListViewModel<test1233.Models.AppProductIngredience>

@{
    ViewData["Title"] = "Product ingredients";
    var productName = ViewData["ProductName"] as string ?? "this product";
}

<div class="container py-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h1 class="h3 mb-1">Product Ingredients</h1>
            <p class="text-muted mb-0">Ingredient details for <strong>@productName</strong>.</p>
        </div>
        <a asp-controller="Home" asp-action="Ordering" class="btn btn-outline-secondary">Back to Ordering</a>
    </div>

    <div class="card shadow-sm border-0">
        <div class="card-body">
            @if (Model.Items.Count == 0)
            {
                <div class="text-muted">
                    No ingredient details are available yet for <strong>@productName</strong>.
                </div>
            }
            else
            {
                <div class="table-responsive">
                    <table class="table table-striped align-middle mb-0">
                        <thead>
                            <tr>
                                <th>Ingredients</th>
                            </tr>
                        </thead>
                        <tbody>
                        @foreach (var productingre in Model.Items)
                        {
                            <tr>
                                <td>@productingre.ProdIngredienceName</td>
                            </tr>
                        }
                        </tbody>
                    </table>
                </div>
            }
        </div>
    </div>
</div>
