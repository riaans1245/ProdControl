@model test1233.Models.TableFormViewModel

@{
    ViewData["Title"] = "Book Table";
}

<div class="container py-4" style="max-width: 620px;">
    <div class="card shadow-sm border-0">
        <div class="card-body p-4">
            <h1 class="h3 mb-3">Book Table</h1>

            <form method="post">
                @Html.AntiForgeryToken()
                <input asp-for="TableId" type="hidden" />
                <input asp-for="UserId" type="hidden" />
                <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

                <div class="mb-3">
                    <label asp-for="TableName" class="form-label"></label>
                    <input asp-for="TableName" class="form-control" />
                    <span asp-validation-for="TableName" class="text-danger"></span>
                </div>

                <div class="mb-4">
                     <label asp-for="TableNumber" class="form-label"></label>
                    <input asp-for="TableNumber" class="form-control" />
                    <span asp-validation-for="TableNumber" class="text-danger"></span>
                </div>

                <div class="mb-4">
                    <label asp-for="BookedForUtc" class="form-label"></label>
                    <input asp-for="BookedForUtc" type="datetime-local" class="form-control" />
                    <span asp-validation-for="BookedForUtc" class="text-danger"></span>
                </div>

                <p class="text-muted mb-4">This booking will be saved for your currently signed-in account.</p>

                <div class="d-flex gap-2">
                    <button type="submit" class="btn btn-dark">Book table</button>
                    <a asp-action="UserOrderTable" class="btn btn-outline-secondary">Cancel</a>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
