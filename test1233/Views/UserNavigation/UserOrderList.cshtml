@model test1233.Models.UserOrderListViewModel

@{
    ViewData["Title"] = "My Orders";
}

<div class="container py-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h1 class="h3 mb-1">My Orders</h1>
            <p class="text-muted mb-0">Review the items ready for payment, then continue to the payment receipt page.</p>
        </div>
    </div>

    @if (TempData["OrderListMessage"] is string orderListMessage && !string.IsNullOrWhiteSpace(orderListMessage))
    {
        <div class="alert alert-success shadow-sm" role="alert">
            @orderListMessage
        </div>
    }

    <form method="get" class="row g-2 align-items-end mb-4">
        <div class="col-sm-8 col-md-6 col-lg-4">
            <label for="searchString" class="form-label">Search my orders</label>
            <input id="searchString"
                   name="searchString"
                   value="@Model.SearchString"
                   class="form-control"
                   placeholder="Search by Item, Order #, or Category" />
        </div>
        <div class="col-auto">
            <button type="submit" class="btn btn-dark">Search</button>
        </div>
        <div class="col-auto">
            <a asp-action="UserOrderList" class="btn btn-outline-secondary">Clear</a>
        </div>
    </form>

    <div class="card shadow-sm border-0">
        <div class="card-body">
            @if (Model.Orders.Items.Count == 0)
            {
                <div class="text-muted">
                    @(string.IsNullOrWhiteSpace(Model.SearchString)
                        ? "No items are waiting in your order list yet."
                        : $"No order items found for \"{Model.SearchString}\".")
                </div>
            }
            else
            {
                <div class="table-responsive">
                    <table class="table table-striped align-middle mb-0">
                        <thead>
                            <tr>
                                <th>Order #</th>
                                <th>Placed</th>
                                <th>Name</th>
                                <th>Category</th>
                                <th>Quantity</th>
                                <th>Unit Price</th>
                                <th>Price</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var row in Model.Orders.Items)
                            {
                                <tr>
                                    <td>@row.OrderId</td>
                                    <td>@row.PlacedAtUtc.ToLocalTime().ToString("dd MMM yyyy h:mm tt")</td>
                                    <td>@row.Name</td>
                                    <td>@row.CategoryName</td>
                                    <td>@row.Quantity</td>
                                    <td>@row.Price.ToString("C")</td>
                                    <td>@row.LineTotal.ToString("C")</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>

                @if (Model.Orders.TotalPages > 1)
                {
                    <div class="d-flex justify-content-between align-items-center mt-4">
                        <span class="text-muted small">Page @Model.Orders.PageNumber of @Model.Orders.TotalPages</span>
                        <nav aria-label="Order pagination">
                            <ul class="pagination mb-0">
                                <li class="page-item @(Model.Orders.HasPreviousPage ? null : "disabled")">
                                    <a class="page-link"
                                       asp-action="UserOrderList"
                                       asp-route-searchString="@Model.SearchString"
                                       asp-route-page="@(Model.Orders.PageNumber - 1)">Previous</a>
                                </li>
                                @for (var pageNumber = 1; pageNumber <= Model.Orders.TotalPages; pageNumber++)
                                {
                                    <li class="page-item @(pageNumber == Model.Orders.PageNumber ? "active" : null)">
                                        <a class="page-link"
                                           asp-action="UserOrderList"
                                           asp-route-searchString="@Model.SearchString"
                                           asp-route-page="@pageNumber">@pageNumber</a>
                                    </li>
                                }
                                <li class="page-item @(Model.Orders.HasNextPage ? null : "disabled")">
                                    <a class="page-link"
                                       asp-action="UserOrderList"
                                       asp-route-searchString="@Model.SearchString"
                                       asp-route-page="@(Model.Orders.PageNumber + 1)">Next</a>
                                </li>
                            </ul>
                        </nav>
                    </div>
                }
            }
        </div>
        <div class="card-footer bg-white d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-3">
            <div>
                <div class="small text-muted">Items waiting for payment</div>
                <div class="fw-semibold">
                    <span>@Model.PendingOrderCount</span> item(s),
                    <span>@Model.PendingOrderTotal.ToString("C")</span>
                </div>
            </div>
            <a asp-action="UserOrderPlace"
               class="btn btn-success @(Model.HasOrders ? null : "disabled")"
               aria-disabled="@(Model.HasOrders ? "false" : "true")">Place Order</a>
        </div>
    </div>
</div>
