@model IReadOnlyCollection<test1233.Models.ContactUs>

@{
    ViewData["Title"] = "Contactus";
}

<div class="container py-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h1 class="h3 mb-1">Contact Us</h1>
            <p class="text-muted mb-0">Current Contact-Us info available in the system.</p>
        </div>
    </div>

    <div class="card shadow-sm border-0">
        <div class="card-body">

             @if (Model is null || Model.Count == 0)
            {
                <div class="text-muted">
                    No contact-us information is available.
                </div>
            }
            else
            {
            <div class="table-responsive">
                <table class="table table-striped align-middle mb-0">
                    <thead>
                        <tr>
                            <th>Id</th>
                            <th>Name</th>
                            <th>Surname</th>
                            <th>Cell No</th>
                            <th>Email Address</th>
                            <th class="text-end">Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                    @foreach (var contactus in Model)
                    {
                        <tr>
                            <td>@contactus.Id</td>
                            <td>@contactus.Name</td>
                            <td>@contactus.Surname</td>
                            <td>@contactus.CellNo</td>
                            <td>@contactus.EmailAddress</td>
                            <td class="text-end">
                                <a asp-action="Delete" asp-route-id="@contactus.Id" class="btn btn-sm btn-outline-danger grid-action-button">Delete</a>
                            </td>
                        </tr>
                    }
                    </tbody>
                </table>
            </div>
            }
        </div>
    </div>
</div>
